@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.HDSD;
@using HIA.Core.Models.Token;
@using System.Security.Claims;
@{
    ViewData["Title"] = "Chỉ định đồng thời";

    var curCSKCB = User.FindFirst(ClaimKey.MA_CSKCB)?.Value;
    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER);
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.ADMIN);
}

<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">Quản lý Danh mục Chỉ định đồng thời</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">Chỉ định đồng thời</li>
                </ol>
                <a href="@Url.Action(nameof(ChiDinhDongThoiController.Create), Uti.GetControllerName(nameof(ChiDinhDongThoiController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom table-sticky">
                <table class="table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.ACTIONS</th>
                            <th>@DisplayFieldResource.NO</th>
                            <th>Chỉ định</th>
                            <th>Mã dịch vụ</th>
                            <th>Dịch vụ khác</th>
                            <th>Vật tư BHYT</th>
                            <th>Vật tư ko BHYT</th>
                            <th>Cùng hồ sơ</th>
                            <th>Cùng ngày YL</th>
                            <th>Cùng thời điểm</th>
                            <th>Nội dung lỗi</th>
                            <th>Hiệu lực</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script>
        $('#tbl_DataTable').DataTable({
            responsive: false,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(ChiDinhDongThoiController.GetItems), Uti.GetControllerName(nameof(ChiDinhDongThoiController)))",
                type: 'POST'
            },
            language: {
                "search": "",
                "searchPlaceholder": "Tìm kiếm..."
            },
            columnDefs: [
                    { width: 80, targets: "_all" }
            ],
            order: [[0, "asc"]],
            columns: [
                {
                    render: function (data, type, row, meta) {
                        console.trace(row);
                        @if (isAdmin == true)
                        {
                            <text>
                                if (row.ma_CSKCB != '@curCSKCB') return '';
                            </text>
                        }
                        var actSts = row.hieu_LUC ? 'pause' : 'play';
                        var actTit = row.hieu_LUC ? 'Hủy bỏ hiệu lực của Chỉ định đồng thời' : 'Kích hoạt hiệu lực cho Chỉ định đồng thời';
                        return `<a href="@Url.Action(nameof(ChiDinhDongThoiController.Edit), Uti.GetControllerName(nameof(ChiDinhDongThoiController)))?id=${row.cddtID}" class="edit-icon" title="Chỉnh sửa nội dung này"><i class="icon-note"></i></a>` + ' &nbsp; ' +
                            `<a href="@Url.Action(nameof(ChiDinhDongThoiController.Activate), Uti.GetControllerName(nameof(ChiDinhDongThoiController)))?id=${row.cddtID}&sts=${!row.hieu_LUC}" class="del-icon" title="${actTit}"><i class="icon-control-${actSts}"></i></a>`;
                    },
                    className: "w-50"
                },
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    },
                    className: "w-50"
                },
                {
                    data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Chi_DINH))",
                    render: function(data, type, row, meta) {
                        return data ? '&#10004;' : '&#10006;';
                    },
                    className: "w-50"
                },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Ma_DICH_VU))", className: "w-350" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Dich_VU_KHAC))", className: "w-350" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Vat_TU_BHYT))", className: "w-350" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Vat_TU_KO_BH))", className: "w-350" },
                {
                    data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    name: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    autoWidth: true,
                    render: function (data, type, row, meta) {
                        const fld = "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))";
                        return row[fld] == 1 ? '&#10004;' : '&#10006;';
                    },
                    className: "w-50"
                },
                {
                    data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    name: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    autoWidth: true,
                    render: function (data, type, row, meta) {
                        const fld = "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))";
                        return row[fld] == 2 ? '&#10004;' : '&#10006;';
                    },
                    className: "w-50"
                },
                {
                    data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    name: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))",
                    autoWidth: true,
                    render: function (data, type, row, meta) {
                        const fld = "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Cung_LOAI))";
                        return row[fld] == 3 ? '&#10004;' : '&#10006;';
                    },
                    className: "w-50"
                },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Noi_DUNG_LOI))", className: "w-650" },
                {
                    data: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Hieu_LUC))",
                    name: "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Hieu_LUC))",
                    autoWidth: true,
                    render: function (data, type, row, meta) {
                        const isActived = "@Uti.SetLowerCaseFirstChar(nameof(ChiDinhDongThoiInfoModel.Hieu_LUC))";
                        return row[isActived]
                            ? `<span class="status-active">@DisplayFieldResource.ACTIVE</span>`
                            : `<span class="status-inactive">@DisplayFieldResource.INACTIVE</span>`;
                    },
                    className: "w-50"
                },
            ],
            createdRow: function (row, data, dataIndex) {
                if (data.hieu_LUC)
                {
                    var bgColor = data.chi_DINH ? "LimeGreen" : "OrangeRed";
                    $(row).css("color", bgColor);
                }
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });
    </script>
}