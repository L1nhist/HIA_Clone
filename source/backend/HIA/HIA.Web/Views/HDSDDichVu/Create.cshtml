@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Token;
@using System.Security.Claims;
@model HIA.Core.Models.HDSD.ModifyHDSDDichVuModel
@{
    ViewData["Title"] = @DisplayFieldResource.MENU_HDSDDICHVU_MAGEME;

    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER);
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.ADMIN);
}

<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2-bootstrap.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/tagslist.css")" />

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@DisplayFieldResource.MENU_HDSDDICHVU_MAGEME</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HDSDThuocController.Index), Uti.GetControllerName(nameof(HDSDThuocController)))">@DisplayFieldResource.MENU_HDSDDICHVU_MAGEME</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.CREATE_NEW</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <form asp-action="@nameof(HDSDThuocController.Create)">
                <div class="container-fluid">
                    <div class="form-group">
                        <div class="col-9 offset-3">
                            <div class="custom-control custom-switch rule-switch">
                                <input asp-for="Chi_DINH" class="custom-control-input">
                                <label asp-for="Chi_DINH" id="lblChiDinh" class="custom-control-label"><span></span></label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Ma_DICH_VU" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Ma_DICH_VU" class="form-control custom-form-control" />
                            <span asp-validation-for="Ma_DICH_VU" class="text-danger"></span>
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [21.0234.4363] hoặc [36.7*] hoặc [78.4367.*]</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Ten_DICH_VU" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Ten_DICH_VU" class="form-control custom-form-control" />
                            <span asp-validation-for="Ten_DICH_VU" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Ma_NHOM" class="control-label col-2 text-right"></label>
                        <div class="col-3 select2-custom">
                            <input asp-for="Ma_NHOM" class="form-control custom-form-control" />
                        </div>
                        <label asp-for="Ma_LOAI_KCB" class="control-label col-2 offset-1 text-right"></label>
                        <div class="col-3 select2-custom">
                            <input asp-for="Ma_LOAI_KCB" class="form-control custom-form-control" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Do_TUOI" class="control-label col-2 text-right"></label>
                        <div class="col-4">
                            <input asp-for="Do_TUOI" class="form-control custom-form-control" />
                        </div>
                        <div class="col-2 offset-1">
                            <label class="form-check-label">
                                <input asp-for="Co_THAI" class="form-check-input" /> @Html.DisplayNameFor(model => model.Co_THAI)
                            </label>
                        </div>
                        <div class="col-3">
                            <label class="form-check-label">
                                <input asp-for="Cho_CON_BU" class="form-check-input" /> @Html.DisplayNameFor(model => model.Cho_CON_BU)
                            </label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Ma_BENH" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Ma_BENH" class="form-control custom-form-control" />
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [A1.2] hoặc [B6.7*] hoặc [C8.*]</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Thuoc_KHAC" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Thuoc_KHAC" class="form-control custom-form-control" />
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [40.234] hoặc [56.7*] hoặc [18.*]</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Dich_VU_KHAC" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Dich_VU_KHAC" class="form-control custom-form-control" />
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [21.0234.4363] hoặc [36.7*] hoặc [78.4367.*]</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Tien_SU_BENH" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Tien_SU_BENH" class="form-control custom-form-control" />
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [A1.2] hoặc [B6.7*] hoặc [C8.*]</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Thoi_GIAN_THUC_HIEN" class="control-label col-2 text-right"></label>
                        <div class="col-3">
                            <input asp-for="Thoi_GIAN_THUC_HIEN" class="form-control custom-form-control" />
                            <small class="text-warning">Tính bằng ngày, nếu có (p) -> phút, có (h) -> giờ</small>
                        </div>
                        <div class="col-1"></div>
                        <label asp-for="Thoi_GIAN_TOI_THIEU" class="control-label col-2 text-right"></label>
                        <div class="col-2">
                            <input asp-for="Thoi_GIAN_TOI_THIEU" class="form-control custom-form-control" />
                        </div>
                        <div class="col-2"><i>(ngày)</i></div>
                    </div>
                    <div class="form-group row">
                        <label class="control-label col-2 text-right">Số người tối thiểu</label>
                        <div class="col-3">
                            <input asp-for="So_NGUOI_TOI_THIEU" class="form-control custom-form-control" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="control-label col-2 text-right">Mã dịch vụ bỏ qua</label>
                        <div class="col-9">
                            <input asp-for="Ma_DICH_VU_KO_CHECK" class="form-control custom-form-control" />
                            <span asp-validation-for="Ma_DICH_VU_KO_CHECK" class="text-danger"></span>
                            <small class="text-warning">Vui lòng nhập mã theo định dạng [21.0234.4363] hoặc [36.7*] hoặc [78.4367.*]</small>
                        </div>
                    </div>
                    <hr />
                    <div class="text-danger text-center mb-30">
                        * Chọn [Tạo lỗi mới] để thêm mã lỗi mới<br />
                        * Chọn mã lỗi đã có và nhập nội dung mới cần thay đổi vào ô Nội dung lỗi để cập nhật mã lỗi
                    </div>
                    <div class="form-group row">
                        <label asp-for="Ma_LOI" class="control-label col-2 text-right"></label>
                        <div class="col-9 select2-custom">
                            <select asp-for="Ma_LOI" class="form-control select2 filter-change">
                                <option value="0">Tạo lỗi mới</option>
                                @foreach (var item in ViewBag.DMErrors)
                                {
                                    <option value="@item.ErrorCode">@item.ErrorCode | @item.Message</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label asp-for="Noi_DUNG_LOI" class="control-label col-2 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Noi_DUNG_LOI" class="form-control custom-form-control" />
                        </div>
                    </div>
                    @if (isMaster == true)
                    {
                        <div class="form-group row">
                            <label asp-for="Ma_CSKCB" class="control-label col-2 text-right"></label>
                            <div class="col-9">
                                <input asp-for="Ma_CSKCB" class="form-control custom-form-control" />
                            </div>
                        </div>
                    }
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group text-center">
                    <a asp-action="@nameof(HospitalController.Index)" class="btn btn-outline-primary">@DisplayFieldResource.BACK_TO_LIST</a>
                    <input type="submit" value="@DisplayFieldResource.CREATE_NEW" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script src="@Url.Content("~/lib/select2/select2.min.js")"></script>
    <script src="@Url.Content("~/js/tagslist.js")"></script>
    <script>
        $('.select2').select2({ theme: "bootstrap" });

        var dv = new TagsInput({ selector: 'Ma_DICH_VU' }), mb = new TagsInput({ selector: 'Ma_BENH' }), tk = new TagsInput({ selector: 'Thuoc_KHAC' }),
            dk = new TagsInput({ selector: 'Dich_VU_KHAC' }), ts = new TagsInput({ selector: 'Tien_SU_BENH' }),
            dd = new TagsInput({ selector: 'Ma_DICH_VU_KO_CHECK'});
    </script>
}