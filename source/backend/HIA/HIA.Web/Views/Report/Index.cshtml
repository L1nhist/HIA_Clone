<style>
    .chart-wrapper .override-text {
        left: auto;
        right: 10px;
        bottom: 0;
    }
    .errCount {
        border-radius: 15px;
        font-size: 12px;
        color: #fff;
        background: #d00;
        padding: 3px;
        margin-top: -10px;
        position: absolute;
        display: inline-block;
        line-height: 1em;
    }
    .errCount:empty {
        display: none;
    }
    .raised-up {
        height: 0;
    }
    .raised-up a {
        margin-top: -80px;
        margin-right: 30px;
