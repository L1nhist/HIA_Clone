@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script type="text/javascript">
        $(function () {
            CanvasJS.addCultureInfo('vn', {
                decimalSeparator: ',',
                digitGroupSeparator: '.'
            });
            CanvasJS.addColorSet('pieSet',[ '#007bff','#9e9a08','#d93742']);

            var chart1 = new CanvasJS.Chart('chartContainer1', {
                exportEnabled: true,
                animationEnabled: true,
                culture: 'vn',
                height: 400,
                title: {
                    text: 'HỒ SƠ TẢI LÊN',
                    fontFamily: 'sans-serif',
                    fontSize: 20,
                    fontWeight: 'bold',
                    padding: 10
                },
                axisX: {
                    interlacedColor: '#F0F8FF',
                    labelFontSize: 14,
                    valueFormatString: "Ngày DD"
                },
                axisY: {
                    labelFontSize: 14
                },
                data: [{
                    type: 'column',
                    name: 'Số lượt tải Hồ sơ trong ngày',
                    showInLegend: true,
                    dataPoints: @Html.Raw(lst1)
                },{
                    type: 'line',
                    name: 'Số lượng Hồ sơ tải lên',
                    showInLegend: true,
                    dataPoints: @Html.Raw(lst2)
                }]
            });

            var chart2 = new CanvasJS.Chart('chartContainer2', {
                exportEnabled: true,
                animationEnabled: true,
                colorSet:  "pieSet",
                height: 280,
                legend: {
                    fontSize: 14
                },
                data: [{
                    type: 'pie',
                    showInLegend: true,
                    dataPoints: @Html.Raw(lst3)
                }]
            });

            chart1.render();
            chart2.render();
        });
    </script>
}
