<div class="container-fluid">
    <div class="row panel-wrapper">
        <div class="col col-12 col-md-6 col-xl-4 panel-custom blue">
            <div class="panel-content">
                <div class="panel-title row">
                    <div class="p-title-label">Hồ Sơ trong ngày</div>
                </div>
                <div class="p-detail">
                    <h1 class="text-right">
                        <b>@Model.Day.SoHoSo.ToString("#,##0")</b>
                        <small class="text-muted"><small>hồ sơ</small></small>
                    </h1>
                </div>
                <div class="p-detail row">
                    <div class="col-12 p-detail-label">
                        &nbsp;
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        So với hôm qua (@Model.Day.SoHoSoHomQua):
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.Day.ThayDoiHoSoVsHomQuaPct >= 0 ? "success" : "danger")">
                            @(Model.Day.ThayDoiHoSoVsHomQuaPct == 0 ? "" : Model.Day.ThayDoiHoSoVsHomQuaPct > 0 ? "▲" : "▼")
                            @Math.Abs(Model.Day.ThayDoiHoSoVsHomQuaPct ?? 0).ToString("##0.00")%
                        </span>
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        So với bình quân (@Model.Day.SoHoSoBinhQuan):
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.Day.ThayDoiHoSoVsBinhQuanPct >= 0 ? "success" : "danger")">
                            @(Model.Day.ThayDoiHoSoVsBinhQuanPct == 0 ? "" : Model.Day.ThayDoiHoSoVsBinhQuanPct > 0 ? "▲" : "▼")
                            @Math.Abs(Model.Day.ThayDoiHoSoVsBinhQuanPct ?? 0).ToString("##0.00")%
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col col-12 col-md-6 col-xl-4 panel-custom green">
            <div class="panel-content">
                <div class="panel-title row">
                    <div class="p-title-label">Người dùng hoạt động</div>
                </div>
                <div class="p-detail">
                    <h1 class="text-right text-primary">
                        <b>@Model.HoatDong.NguoiCoHoatDong</b>
                        <small class="text-muted">/ @(Model.HoatDong.TongSoNguoiDung)</small>
                    </h1>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        Tương tác trong ngày:
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.HoatDong.TyLeTuongTacPct >= 0 ? "success" : "danger")">
                            @(Model.HoatDong.TyLeTuongTacPct == 0 ? "" : Model.HoatDong.TyLeTuongTacPct > 0 ? "▲" : "▼")
                            @Math.Abs(Model.HoatDong.TyLeTuongTacPct).ToString("##0.00")%
                        </span>
                    </div>
                </div>
                <div class="p-detail">
                    <small class="text-muted">(Lấy báo cáo hoặc hỏi AI)</small>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        Bình quân (người/ngày):
                    </div>
                    <div class="col-5 p-detail-number">
                        @Model.HoatDong.NguoiCoHoatDongBinhQuan
                    </div>
                </div>
            </div>
        </div>
        <div class="col col-12 col-md-6 col-xl-4 panel-custom red">
            <div class="panel-content">
                <div class="panel-title row">
                    <div class="p-title-label">Tổng số lỗi</div>
                </div>
                <div class="p-detail">
                    <h1 class="text-right">
                        <b>@Model.ChatLuong.TongLoi.ToString("#,##0")</b>
                        <small class="text-muted"><small>lỗi</small></small>
                    </h1>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        So với bình quân (@Model.ChatLuong.TongLoiBinhQuan):
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.ChatLuong.PctHoSoCoLoiBinhQuan < 0 ? "success" : "danger")">
                            @(Model.ChatLuong.PctHoSoCoLoiBinhQuan == 0 ? "" : Model.ChatLuong.PctHoSoCoLoiBinhQuan > 0 ? "▲" : "▼")
                            @Math.Abs(Model.ChatLuong.PctHoSoCoLoiBinhQuan).ToString("##0.00")%
                        </span>
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        Bình quân lỗi/lần:
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.ChatLuong.LoiMoiLanDay < 0 ? "success" : "danger")">
                            @(Model.ChatLuong.LoiMoiLanDay == 0 ? "" : Model.ChatLuong.LoiMoiLanDay > 0 ? "▲" : "▼")
                            @Math.Abs(Model.ChatLuong.LoiMoiLanDay).ToString("##0.00")%
                        </span>
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-7 p-detail-label">
                        Tỷ lệ lỗi/hồ sơ:
                    </div>
                    <div class="col-5 p-detail-number">
                        <span class="text-@(Model.ChatLuong.PctHoSoCoLoi < 0 ? "success" : "danger")">
                            @(Model.ChatLuong.PctHoSoCoLoi == 0 ? "" : Model.ChatLuong.PctHoSoCoLoi > 0 ? "▲" : "▼")
                            @Math.Abs(Model.ChatLuong.PctHoSoCoLoi).ToString("##0.00")%
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
