@using HIA.Core.Languages.DisplayField;
@using HIA.Core.Languages.TitlePage;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Token;
@using HIA.Core.Models.HDSD;
@using System.Security.Claims;

@{
    ViewData["Title"] = "Quản lý danh mục Dịch vụ - Mã máy";
    var modelDisplay = new DichVuMaMayInfoModel();
    var maCSKCB = User.FindFirst(ClaimKey.MA_CSKCB).Value;
    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER) ?? false;
}

<link rel="stylesheet" href="@Url.Content("~/lib/elite/libs/dropify/dropify.min.css")">
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2-bootstrap.min.css")" />
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">Quản lý danh mục Dịch vụ - Mã máy</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">Quản lý danh mục Dịch vụ - Mã máy</li>
                </ol>
                <a href="@Url.Action(nameof(DichVuMaMayController.Create), Uti.GetControllerName(nameof(DichVuMaMayController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
            </div>
        </div>
    </div>
    <div class="card upload-file-wrapper">
        <div class="card-body">
            <div class="row handle-file display-flex">
                <div class="col-10 drop-wrapper">
                    <input type="file" id="fileupload" class="dropify " data-allowed-file-extensions='["xls", "xlsx"]' />
                </div>
                <div class="col-2 button-wrapper flex-middle">
                    <button type="button" class="btn btn-block btn-info" onclick="uploadFile()"><i class="icon-cloud-upload"></i> @DisplayFieldResource.UPLOAD_TEXT</button>
                    <button type="button" onclick="downloadFile()" id="btnDownload" class="btn btn-block btn-primary"><i class="icon-cloud-download"></i> @DisplayFieldResource.DOWNLOAD_TEXT</button>
                </div>
            </div>
        </div>
    </div>
    @if (isMaster)
    {
        <div class="card filter-wrapper">
            <div class="card-body">
                <div class="mb-2 select2-custom form-group row">
                    <label class="lbl-filter col-3 col-form-label text-right" for="filterStatus">Bệnh viện</label>
                    <div class="col-9">
                        <select name="filterHospital" id="filterHospital" class="form-control select2 filter-change">
                            @foreach (var item in ViewBag.Hospitals)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <input name="filterHospital" id="filterHospital" type="hidden" value="@maCSKCB" />
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom has-upload fixed-column">
                <table class="stripe table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.NO</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ma_CSKCB)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ma_DICH_VU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ma_MAY)</th>
                            <th>@DisplayFieldResource.ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_spinnerPartial" />
@section Scripts {
    <script src="@Url.Content("~/lib/select2/select2.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/dataTables.fixedColumns.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/dropify/dropify.min.js")"></script>
    <script>
        $('.dropify').dropify({
            messages: @Html.Raw(DropifySettingDefault.MESSAGES),
            error: @Html.Raw(DropifySettingDefault.ERROR),
        });
        function calcDataTableHeight() {
            /*68px: header, 37px: title, 5px: mgbttom-top, 106: upload, 20px: 2 paddtop-bot 10; 32px: footer, 10px: bottom margin*/
            const height = $(window).height() - 68 - 37 - 5 - 106 - 20 - 32 - 5 - 120;
            return height;
        }

        var tmrFilt = 0;
        function callFilter(evt) {
            evt.preventDefault();
            evt.stopPropagation();
            if (tmrFilt) { clearTimeout(tmrFilt); tmrFilt = 0; }
            tmrFilt = setTimeout(function () { dataTbl.ajax.reload(); }, 500);
        }

        $('.filter-change').change(function (e) { callFilter(e); });
        $('.select2').select2({ theme: "bootstrap" });
        var first = 1;
        const dataTbl = $('#tbl_DataTable').DataTable({
            responsive: false,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(DichVuMaMayController.GetItems), Uti.GetControllerName(nameof(DichVuMaMayController)))",
                type: 'POST',
                data: function(d) {
                    d.maCSKCB = $('#filterHospital').val();
                    d.search = first ? '' : dataTbl.search();
                    return d;
                }
            },initComplete: function(settings, json) {
                first = 0;
            },
            columnDefs: [
                { width: 100, targets: "_all" }
            ],
            order: [[1, "asc"]], // set default sort is column 1
            columns: [
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { data: "@nameof(modelDisplay.Ma_CSKCB).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ma_DICH_VU).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ma_MAY).ToLowerInvariant()" },
                {
                    render: function (data, type, row, meta) {
                        const editUrl = '@Url.Action(nameof(DichVuMaMayController.Edit), Uti.GetControllerName(nameof(DichVuMaMayController)))' + `?id=${row.dvmmid}`;
                        return `<a href="${editUrl}" class="edit-icon"><i class="icon-note"></i></a> <a href="#" class="del-icon" onclick="deleteOne(${row.dvmmid});return false;"><i class="icon-trash"></i></a>`;
                    }
                },
            ],
            scrollX: true,
            sScrollY: calcDataTableHeight(),
            scrollCollapse: true,
            fixedColumns: {
                leftColumns: 0,
                rightColumns: 1,
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });

        function uploadFile() {
            const fileExtension = ['xls', 'xlsx'];
            const filename = $('#fileupload').val();

            if (filename.length == 0) return;

            const extension = filename.replace(/^.*\./, '');
            if ($.inArray(extension, fileExtension) == -1) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select only excel files.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return ;
            }

            const fileUpload = $("#fileupload").get(0);
            const file = fileUpload.files[0];
            const maxSize = 10 * 1024 * 1024;
            if (!file || file.size > maxSize) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select file smaller 10Mb.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return;
            }
            var fdata = new FormData();
            fdata.append(file.name, file);
            $("#spinnerWrapper").modal("show");
            $.ajax({
                type: "POST",
                url: "@Url.Action(nameof(DichVuMaMayController.Upload), Uti.GetControllerName(nameof(DichVuMaMayController)))",
                data: fdata,
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    if (response?.code !== 200) {
                        $.toast({
                            heading: 'Upload Fail',
                            text: 'Some error occured while uploading - ' + response.message,
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    dataTbl.ajax.reload();
                    $(".dropify-clear").trigger("click");
                    $.toast({
                        heading: 'Upload success',
                        text: '',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 2000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $.toast({
                        heading: 'Upload Fail',
                        text: 'Some error occured while uploading',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function downloadFile() {
            $("#btnDownload").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");
            var g = { maCSKCB: $('#filterHospital').val(), search: dataTbl.search() };
            $.ajax({
                url: "@Url.Action(nameof(DichVuMaMayController.GetDownloadData), Uti.GetControllerName(nameof(DichVuMaMayController)))",
                type: "GET",
                data: g,
                success: function (response) {
                    if (response.code != 200) {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(DichVuMaMayController.Download), Uti.GetControllerName(nameof(DichVuMaMayController)))' + `?fileGuid=${response.data.fileguid}&fileName=${response.data.filename}`;
                    setTimeout(() => {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');

                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 2000,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function deleteOne(dmId) {
            $("#spinnerWrapper").modal("show");
            $.ajax({
                url: "@Url.Action(nameof(DichVuMaMayController.Delete), Uti.GetControllerName(nameof(DichVuMaMayController)))",
                type: "POST",
                data: {
                    id: dmId,
                    maCSKCB: $('#filterHospital').val()
                },
                success: function (response) {
                    if (response.code != 200) {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    if (tmrFilt) { clearTimeout(tmrFilt); tmrFilt = 0; }
                    tmrFilt = setTimeout(function () { dataTbl.ajax.reload(); }, 500);
                    $.toast({
                        heading: 'Thành công',
                        text: '',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 2000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
    </script>
}