                    // small helper to show non-blocking notification using jquery.toast if available
                    function showClientToast(msg, heading, bgColor){
                        try{
                            if (window.$ && $.toast){
                                $.toast({ heading: heading || '', text: msg || '', showHideTransition: 'fade', icon: 'info', position: 'top-right', bgColor: bgColor || '#333', hideAfter: 4000 });
                            } else {
                                // fallback: lightweight floating element
                                var el = document.createElement('div');
                                el.style.position = 'fixed';
                                el.style.right = '18px';
                                el.style.top = '18px';
                                el.style.padding = '10px 14px';
                                el.style.background = bgColor || 'rgba(0,0,0,0.85)';
                                el.style.color = '#fff';
                                el.style.zIndex = 99999;
                                el.style.borderRadius = '6px';
                                el.innerText = (heading ? heading + ': ' : '') + (msg || '');
                                document.body.appendChild(el);
                                setTimeout(function(){ try{ document.body.removeChild(el); }catch(e){} }, 4000);
                            }
                        }catch(e){ console.warn('toast failed', e); }
                    }

                    // track sends per session
                    var sendTimestamps = [];
                    var MAX_PER_MIN = 20; // adjust as needed
                    var MIN_INTERVAL_MS = 1000; // at least 1s between sends

                    // patch chatter.send to enforce throttle even if called programmatically
                    try{
                        if (window.chatter && typeof window.chatter.send === 'function'){
                            var origSend = window.chatter.send.bind(window.chatter);
                            window.chatter.send = function(rawMsg){
                                var now = Date.now();
                                // prune old timestamps
                                sendTimestamps = sendTimestamps.filter(function(t){ return now - t < 60*1000; });
                                if (sendTimestamps.length >= MAX_PER_MIN){
                                    console.warn('Client throttle: too many sends in the last minute.');
                                    showClientToast('Hành động bị tạm chặn do có quá nhiều yêu cầu. Vui lòng thử lại sau.', 'Bị tạm chặn', '#c0392b');
                                    return;
                                }
                                var last = sendTimestamps.length ? sendTimestamps[sendTimestamps.length-1] : 0;
                                if (now - last < MIN_INTERVAL_MS){
                                    console.warn('Client throttle: sending too fast.');
                                    showClientToast('Gửi quá nhanh, vui lòng chờ một giây giữa các lần gửi.', 'Tốc độ gửi cao', '#f39c12');
                                    // require explicit user gesture: refuse programmatic rapid calls
                                    // If the call originated from a click handler, it will usually be allowed.
                                    return;
                                }
                                // if message originates from postMessage (auto), we will only populate input and NOT auto-send
                                if (typeof rawMsg === 'string' && rawMsg && rawMsg.__auto === true){
                                    // populate UI only
                                    try{ var prompt = document.getElementById('prompt'); if(prompt) prompt.value = rawMsg.text || ''; } catch(e){}
                                    console.info('Auto message populated; user must confirm send.');
                                    showClientToast('Tin nhắn đã được tự động điền. Vui lòng nhấn Gửi để xác nhận.', 'Tin nhắn tự động', '#2ecc71');
                                    return;
                                }

                                // passed checks -> record and call original
                                sendTimestamps.push(now);
                                return origSend(rawMsg);
                            };
                        }
                    }catch(e){ console.error('Failed to patch chatter.send for throttling', e); }

                    // Intercept incoming postMessage and convert to populate-only messages
                    window.addEventListener('message', function(ev){
                        // allowed origins mirror the iframe whitelist
                        var allowed = ['https://egdbh.vn','https://mdinsight.vn'];
                        try{
                            if (!allowed.includes(ev.origin)) return;
                            var data = ev.data;
                            if (!data) return;
                            // expect structured message { type: 'ai-request', text }
                            if (typeof data === 'object' && data.type === 'ai-request'){
                                // populate but do not auto-send
                                if (window.chatter && typeof window.chatter.send === 'function'){
                                    window.chatter.send({ __auto: true, text: data.text });
                                }
                            }
                        }catch(ex){ /* swallow */ }
                    }, false);
                })();
            </script>
        @* LINHIST ADDED ZONE FOR CHAT*@
    }
</body>
