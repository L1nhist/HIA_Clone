@using HIA.Core.Languages.DisplayField;
@using HIA.Core.Languages.TitlePage;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Categories;

@{
    ViewData["Title"] = TitlePageResource.DM_VTYT_TITLE;
    var modelDisplay = new DMVTYTInfoModel();
}

<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">
<link rel="stylesheet" href="@Url.Content("~/lib/elite/libs/dropify/dropify.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@TitlePageResource.DM_VTYT_TITLE</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@TitlePageResource.DM_VTYT_TITLE</li>
                </ol>
                <a href="@Url.Action(nameof(DMVTYTController.Create), Uti.GetControllerName(nameof(DMVTYTController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
                @if (ViewBag.AllowImport)
                {
                    <button class="btn btn-light d-none d-lg-block m-l-15 btn-add" onclick="importData()">
                        <i class="fa fa-sync-alt"></i> Đồng bộ
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="card upload-file-wrapper">
        <div class="card-body">
            <div class="row handle-file display-flex">
                <div class="col-10 drop-wrapper">
                    <input type="file" id="fileupload" class="dropify " data-allowed-file-extensions='["xls", "xlsx"]' />
                </div>
                <div class="col-2 button-wrapper flex-middle">
                    <button type="button" class="btn btn-block btn-info" onclick="uploadFile()"><i class="icon-cloud-upload"></i> @DisplayFieldResource.UPLOAD_TEXT</button>
                    <button type="button" onclick="downloadFile()" id="btnDownload" class="btn btn-block btn-primary"><i class="icon-cloud-download"></i> @DisplayFieldResource.DOWNLOAD_TEXT</button>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom has-upload fixed-column">
                <table class="table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.NO</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ma_VAT_TU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nhom_VAT_TU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ten_VAT_TU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ma_HIEU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Quy_CACH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_VI_TINH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_GIA)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_GIA_BH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.So_LUONG)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nuoc_SX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nha_SX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nha_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Loai_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Tt_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ht_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Quyet_DINH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Dinh_MUC)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Tyle_TT_BH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MaNHOM_9324)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MaNHOM_5937)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Tu_NGAY)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Den_NGAY)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ngay_DE_NGHI)</th>
                            <th>@DisplayFieldResource.ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_spinnerPartial" />
@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/dataTables.fixedColumns.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/dropify/dropify.min.js")"></script>
    <script>
        $('.dropify').dropify({
            messages: @Html.Raw(DropifySettingDefault.MESSAGES),
            error: @Html.Raw(DropifySettingDefault.ERROR),
        });
        function calcDataTableHeight() {
            /*68px: header, 37px: title, 5px: mgbttom-top, 106: upload, 20px: 2 paddtop-bot 10; 32px: footer, 10px: bottom margin*/
            const height = $(window).height() - 68 - 37 - 5 - 106 - 20 - 32 - 5 - 120;
            return height;
        }
        const dataTbl = $('#tbl_DataTable').DataTable({
            responsive: false,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(DMVTYTController.GetItems), Uti.GetControllerName(nameof(DMVTYTController)))",
                type: 'POST',
            },
            columnDefs: [
                { width: 100, targets: "_all" }
            ],
            order: [[1, "asc"]], // set default sort is column 1
            columns: [
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { data: "@nameof(modelDisplay.Ma_VAT_TU).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Nhom_VAT_TU ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ten_VAT_TU ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ma_HIEU).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Quy_CACH).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Don_VI_TINH).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Don_GIA).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Don_GIA_BH).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.So_LUONG).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Nuoc_SX).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Nha_SX).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Nha_THAU).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Loai_THAU).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Tt_THAU ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ht_THAU ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Quyet_DINH).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Dinh_MUC).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Tyle_TT_BH ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.MaNHOM_9324).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.MaNHOM_5937).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Tu_NGAY ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Den_NGAY ).ToLowerInvariant()" },
                { data: "@nameof(modelDisplay.Ngay_DE_NGHI ).ToLowerInvariant()" },
                {
                    render: function (data, type, row, meta) {
                        const editUrl = '@Url.Action(nameof(DMVTYTController.Edit), Uti.GetControllerName(nameof(DMVTYTController)))' + `?id=${row.vtid}`;
                        const delUrl = '@Url.Action(nameof(DMVTYTController.DeleteAction), Uti.GetControllerName(nameof(DMVTYTController)))' + `?id=${row.vtid}`;
                        return `<a href="${editUrl}" class="edit-icon"><i class="icon-note"></i></a> <a href="${delUrl}" class="del-icon"><i class="icon-trash"></i></a>`;
                    }
                },
            ],
            scrollX: true,
            sScrollY: calcDataTableHeight(),
            scrollCollapse: true,
            fixedColumns: {
                leftColumns: 0,
                rightColumns: 1,
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });
        function uploadFile() {
            const fileExtension = ['xls', 'xlsx'];
            const filename = $('#fileupload').val();

            if (filename.length == 0) return;


            const extension = filename.replace(/^.*\./, '');
            if ($.inArray(extension, fileExtension) == -1) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select only excel files.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return ;
            }

            const fileUpload = $("#fileupload").get(0);
            const file = fileUpload.files[0];
            const maxSize = 10 * 1024 * 1024;
            if (!file || file.size > maxSize) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select file smaller 10Mb.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return;
            }
            var fdata = new FormData();
            fdata.append(file.name, file);
            $("#spinnerWrapper").modal("show");
            $.ajax({
                type: "POST",
                url: "@Url.Action(nameof(DMVTYTController.Upload), Uti.GetControllerName(nameof(DMVTYTController)))",
                data: fdata,
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    if (response?.code !== 200) {
                        $.toast({
                            heading: 'Upload Fail',
                            text: 'Some error occured while uploading - ' + response.message,
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    dataTbl.ajax.reload();
                    $(".dropify-clear").trigger("click");
                    $.toast({
                        heading: 'Upload success',
                        text: '',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 2000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $.toast({
                        heading: 'Upload Fail',
                        text: 'Some error occured while uploading',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function downloadFile() {
            $("#btnDownload").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");
            $.ajax({
                url: "@Url.Action(nameof(DMVTYTController.GetDownloadData), Uti.GetControllerName(nameof(DMVTYTController)))",
                method: "GET",
                contentType: "application/json",
                cache: false,
                success: function (response) {
                    if (response.code != 200) {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(DMVTYTController.Download), Uti.GetControllerName(nameof(DMVTYTController)))' + `?fileGuid=${response.data.fileguid}&fileName=${response.data.filename}`;
                    setTimeout(() => {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');

                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 2000,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function importData() {
            $("#spinnerWrapper").modal("show");
            $.ajax({
                type: "POST",
                url: "@Url.Action(nameof(DMVTYTController.Import), Uti.GetControllerName(nameof(DMVTYTController)))",
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    if (response?.code !== 200) {
                        $.toast({
                            heading: 'Đồng bộ Danh mục',
                            text: response.message ?? 'Không thể đồng bộ dữ liệu',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 6000,
                            stack: 6
                        });
                        return;
                    }

                    dataTbl.ajax.reload();
                    $(".dropify-clear").trigger("click");
                    $.toast({
                        heading: 'Đồng bộ Danh mục',
                        text: 'Đã đồng bộ thành công dữ liệu từ cổng Bảo hiểm',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 6000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $.toast({
                        heading: 'Đồng bộ Danh mục',
                        text: 'Không thể đồng bộ dữ liệu',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 6000,
                        stack: 6
                    });
                }
            });
        }
    </script>
}
