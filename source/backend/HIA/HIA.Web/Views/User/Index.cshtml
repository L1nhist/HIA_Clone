@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.User;
@{
    ViewData["Title"] = @DisplayFieldResource.MENU_USER_MAGEME;

    var modelDisplay = new UserInfoModel();
}

<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@DisplayFieldResource.MENU_USER_MAGEME</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.MENU_USER_MAGEME</li>
                </ol>
                <a href="@Url.Action(nameof(UserController.Create), Uti.GetControllerName(nameof(UserController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom not-custom-filter fixed-column">
                <table class="table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.NO</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.HospitalName)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Email)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.RoleName)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.FullName)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.PhoneNumber)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.IsActivated)</th>
                            <th>@DisplayFieldResource.ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script>
        function calcDataTableHeight() {
            /*68px: header, 36px: title, 5px: mgbttom-top, 20px: 2 paddtop-bot 10; 32px: footer, 5px: bottom margin*/
            const height = $(window).height() - 68 - 36 - 5 - 20 - 32 - 5 ;
            return height;
        }
        $('#tbl_DataTable').DataTable({
            //responsive: true,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(UserController.GetItems), Uti.GetControllerName(nameof(UserController)))",
                type: 'POST'
            },
            columnDefs: [
                { targets: [0, 7], orderable: false },
            ],
            order: [[1, "asc"]],
            columns: [
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    },
                    className: "w-50"
                },
                { data: "@nameof(modelDisplay.HospitalName).ToLowerInvariant()", name: "@nameof(modelDisplay.HospitalName).ToLowerInvariant()", autoWidth: true },
                { data: "@nameof(modelDisplay.Email).ToLowerInvariant()", name: "@nameof(modelDisplay.Email).ToLowerInvariant()", autoWidth: true },
                { data: "@nameof(modelDisplay.RoleName).ToLowerInvariant()", name: "@nameof(modelDisplay.RoleName).ToLowerInvariant()", autoWidth: true },
                { data: "@nameof(modelDisplay.FullName).ToLowerInvariant()", name: "@nameof(modelDisplay.FullName).ToLowerInvariant()", autoWidth: true },
                { data: "@nameof(modelDisplay.PhoneNumber).ToLowerInvariant()", name: "@nameof(modelDisplay.PhoneNumber).ToLowerInvariant()", autoWidth: true },
                {
                    data: "@nameof(modelDisplay.IsActivated).ToLowerInvariant()",
                    name: "@nameof(modelDisplay.IsActivated).ToLowerInvariant()",
                    autoWidth: true,
                    render: function (data, type, row, meta) {
                        const isActived = "@nameof(modelDisplay.IsActivated).ToLowerInvariant()";
                        const isFirstTimeLogin = "@nameof(modelDisplay.IsFirstTimeLogin).ToLowerInvariant()";
                        return row[isFirstTimeLogin]
                            ? `<span class="status-pending">@DisplayFieldResource.PENDING</span>`
                            : (row[isActived]
                                ? `<span class="status-active">@DisplayFieldResource.ACTIVE</span>`
                                : `<span class="status-inactive">@DisplayFieldResource.INACTIVE</span>`);
                    }
                },
                {
                    render: function (data, type, row, meta) {
                        const editUrl = '@Url.Action(nameof(UserController.Edit), Uti.GetControllerName(nameof(UserController)))' + `?id=${row.id}`;
                        const delUrl = '@Url.Action(nameof(UserController.DeleteAction), Uti.GetControllerName(nameof(UserController)))' + `?id=${row.id}`;
                        return `<a href="${editUrl}" class="edit-icon"><i class="icon-note"></i></a> <a href="${delUrl}" class="del-icon"><i class="icon-trash"></i></a>`;
                    },
                    className: "w-50"
                },
            ],
            scrollX: true,
            sScrollY: calcDataTableHeight(),
            scrollCollapse: true,
            fixedColumns: {
                leftColumns: 0,
                rightColumns: 1,
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });
    </script>
}