                fail: function() {
                    $("#spinnerWrapper").modal("hide");
                    $("#detailModal").modal("hide");

                    $.toast({
                        heading: 'Cảnh báo',
                        text: 'Dữ liệu XML1 không hợp lệ.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                },
                complete: function() {
                    btnActiv(1);
                }
            });
        }

        var downloadUrls = [
            '@Url.Action(nameof(Files130Controller.GetDownloadData1), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData2), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData3), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData4), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData5), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData6), Uti.GetControllerName(nameof(Files130Controller)))',
            '@Url.Action(nameof(Files130Controller.GetDownloadData7), Uti.GetControllerName(nameof(Files130Controller)))'
        ];
        function downloadFile(idx) {
            if (idx == 6) {
                if (!$('#fromDateCreate').val()) {
                    $.toast({
                        heading: 'Chú ý',
                        text: 'Bạn chưa nhập Ngày tạo, thời gian tính chấm công sẽ là mặc định trong tháng hiện tại!.',
                        position: 'top-center',
                        loader: false,
                        icon: 'info',
                        hideAfter: 2500,
                        stack: false
                    });
                }
            }
            else {
                if (!tblData.data().length) {
                    $.toast({
                        heading: 'Cảnh báo',
                        text: 'Không có dữ liệu.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                    return;
                }
                
                var hasDate = false;
                $('.input-daterange input').each(function(){
                    if (this.value) {
                        hasDate = true;
                        return false;
                    }
                });

                if (!hasDate || !$("#filterError").val()) {
                    $.toast({
                        heading: 'Cảnh báo',
                        text: 'Vui lòng chọn ít nhất 1 mục ngày tháng (ngày vào, ngày ra, ngày tạo hoặc ngày thanh toán) hoặc loại lỗi để tải báo cáo.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                    return;
                }
            }

            $(".btn-download").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");

            $.ajax({
                url: downloadUrls[idx],
                method: "GET",
                data: function (d) {
                    d.filterDateIns = [$("#fromDateIn").val(), $('#toDateIn').val()];
                    d.filterDateOuts = [$("#fromDateOut").val(), $('#toDateOut').val()];
                    d.filterDateCreates = [$("#fromDateCreate").val(), $('#toDateCreate').val()];
                    d.departments = $("#filterDepartment").val();
                    d.filterErrors = $("#filterError").val();
                    d.filterStatus = $('#filterStatus').val();
                    d.filterDatePaids = [$("#fromDatePaid").val(), $('#toDatePaid').val()];
                    d.filterKCB = $('#filterKCB').val();
                    d.filterHospital = $('#filterHospital').val();
                    d.timeRanges = [$("#fromHour").val(), $("#fromMin").val(), $('#toHour').val(), $("#toMin").val()];
                    btnActiv(0);
                    return d;
                },
                contentType: "application/json",
                cache: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    $(".btn-download").removeClass('disabled-custom');

                    if (response.code != 200) {
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 3500,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(Files130Controller.Download), Uti.GetControllerName(nameof(Files130Controller)))' + `?fileGuid=${response.data.fileguid}&fileName=${response.data.filename}`;
                    setTimeout(() => {
                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 3500,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $(".btn-download").removeClass('disabled-custom');

                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                },
                complete: function() {
                    btnActiv(1);
                }
            });
        }

        function recheckAll() {
            const xml1Length = dataTbl?.data()?.length;
            if (!xml1Length || xml1Length > 3000) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: xml1Length ? 'Số lượng hồ sơ quá lớn (> 3000).' : 'Không có dữ liệu.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            var hasDate = false;
            var inp = $('input', datePickrs);
            for (var i = 0; i < inp.length; i++) {
                if (inp.eq(i).val()) {
                    hasDate = true;
                    break;
                }
            }

            if (!hasDate || !$("#filterError").val()) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: 'Vui lòng chọn ít nhất 1 mục ngày tháng (ngày vào, ngày ra, ngày tạo hoặc ngày thanh toán) hoặc loại lỗi để tải báo cáo.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            if (!confirm('Những hồ sơ đã chọn sẽ được đánh dấu để kiểm tra lại tự động. Bạn đã chắc chắn muốn thực hiện chức năng này???')) return;

            $("#btnRecheck").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");

            var path = '@Url.Action(nameof(Files130Controller.RecheckAll), Uti.GetControllerName(nameof(Files130Controller)))';
            $.ajax({
                url: path,
                data: function (d) {
                    d.filterDateIns = [$("#fromDateIn").val(), $('#toDateIn').val()];
                    d.filterDateOuts = [$("#fromDateOut").val(), $('#toDateOut').val()];
                    d.filterDateCreates = [$("#fromDateCreate").val(), $('#toDateCreate').val()];
                    d.departments = $("#filterDepartment").val();
                    d.filterErrors = $("#filterError").val();
                    d.filterStatus = $('#filterStatus').val();
                    d.filterDatePaids = [$("#fromDatePaid").val(), $('#toDatePaid').val()];
                    d.filterKCB = $('#filterKCB').val();
                    d.filterHospital = $('#filterHospital').val();
                    d.timeRanges = [$("#fromHour").val(), $("#fromMin").val(), $('#toHour').val(), $("#toMin").val()];
                    btnActiv(0);
                    return d;
                },
                method: "POST",
                dataType: "json",
                success: function (res) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnRecheck").removeClass('disabled-custom');

                    if (!res.recordsTotal) {
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 3500,
                            stack: 6
                        });
                    }
                    else {
                        $.toast({
                            heading: 'Thành công',
                            text: res.recordsTotal.toString() + ' hồ sơ đã vào hàng đợi, vui lòng chờ hệ thống kiểm tra lại hoàn thành',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 5000,
                            stack: 6
                        });

                        dataTbl.ajax.reload();
                    }
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');

                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                },
                complete: function() {
                    btnActiv(1);
                }
            });
        }

