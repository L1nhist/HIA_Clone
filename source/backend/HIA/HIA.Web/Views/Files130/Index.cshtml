                    return d;
                },
                complete: function() {
                    btnActiv(1);
                }
            },
            order: [],
            columns: cols,
            createdRow: function (row, data, dataIndex) {
                if (data.is_valid) {
                    $(row).css("color", data.has_errors ? "OrangeRed" : data.has_alerts ? "#ffc107" : "LimeGreen");
                }
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });

        var tmrFilt = 0;
        function callFilter(evt) {
            evt.preventDefault();
            evt.stopPropagation();
            if (tmrFilt) { clearTimeout(tmrFilt); tmrFilt = 0; }
            tmrFilt = setTimeout(function () { tblData.ajax.reload(); }, 500);
        }

        function renderCell(data, xml, property, row) {
            data = data || '';
            var lst = errLst ? (errLst[xml] || []) : [], errs = [];
            if (lst && lst.length) {
                for (var i = 0; i < lst.length; i++) {
                    var e = lst[i];
                    if (e.error_row === row.stt && e.error_tag.toLowerCase() === property.toLowerCase()) errs.push(e);
                }
            }
            if (!errs.length) return data;

            var cods = errs.map(e => e.error_code).join(';');
            var msg = errs.map(e => e.message).join(', ');
            //var desc = errs.map(e => e.error_desc).join(', ');
            var desc = '';
            try{ desc = (errs[0] && typeof errs[0].error_desc !== 'undefined') ? errs[0].error_desc : (errs[0] || ''); }catch(e){ desc = '' }

            var refer = `XML01ID: ${curXml1.xml01id}; Mã CSKCB: ${curXml1.ma_cskcb}; Mã LK: ${curXml1.ma_lk}; Mã BN: ${curXml1.ma_bn}; Mã lỗi: ${cods}`;

            var spc = '';
            var raw = data.toString();
            while (raw.length > 0) {
                spc += raw.charAt(0) == ' ' ? '<i>&nbsp;</i>' : raw.charAt(0).toString();
                raw = raw.substr(1);
            }
            return `<span class="glow_space">${spc}</span> <i class="fas error-icon ai-asking ${(errs.some(e => !e.is_alert) ? ' fa-exclamation-triangle' : 'fa-exclamation-circle')}" title="${msg}" data-ai-msg="${desc}" data-ai-pref="${refer}"></i>`;
        }
        function renderRowError(row, data) {
            if (data.is_alert == true) {
                $(row).css('color', 'Goldenrod');
            }
            else if (data.is_alert == false) {
                $(row).css('color', 'OrangeRed');
            }
            else {
                var aCell = $(row).find('i.alert-icon').parent();
                aCell.addClass('alert-row');
                if (aCell.length) {
                    $(row).css('color', 'Goldenrod');
                }

                var eCell = $(row).find('i.error-icon').parent();
                eCell.addClass('error-row');
                if (eCell.length) {
                    $(row).css('color', 'OrangeRed');
                }
            }
        }

        var tablst = $('#navLinks .nav-link'), tblXML = {};
        function resetView() {
            tablst.removeClass('active').each(function () {
                var a = $(this), c = a.attr('href').slice(1);
                if (c === 'xml1') { a.addClass('active'); }
                else if (c != 'error') { a.addClass('reload'); }
            });
            $('#tabPanes .tab-pane').removeClass('active').eq(0).addClass('active');

            if (curXml1) {
                var lst = curXml1.has_files.split(';');
                $('#navLinks .nav-link').each(function () {
                    var a = $(this), xml = a.attr('href').substring(1);
                    if (xml === 'xml1' || xml === 'error' || xml === 'history') return;
                    for (var i = 0; i < lst.length; i++) {
                        if (xml.indexOf(lst[i]) >= 0) { a.removeClass('disabled'); }
                        else if (!a.hasClass('disabled')) { a.addClass('disabled'); }
                    }
                });
                $('#preXML1 input').each(function () {
                    this.value = curXml1[this.id.toLowerCase()];
                });
                $('#frmXML1 input').each(function () {
                    this.value = curXml1[this.id.toLowerCase()];
                });
            }
        }

        var cles = [], flds = headCaps['error'];
        for (var i = 0; i < flds.length; i++) {
            var c = { data: flds[i].toLowerCase() };
            if (c.data == 'error_code' || c.data == 'error_row' || c.data == 'error_tag') { c.className = 'w-50'; }
            if (c.data == 'ma_ax' || c.data =="ma_bs_yl" || c.data == 'error_value') { c.className = 'w-200'; }
            if (c.data == 'ma_bs_cd') { c.className = 'w-450'; }
            if (c.data == 'message' || c.data == 'ten_ax') { c.className = 'w-650'; }
            cles.push(c);
        }
        var tblError = $('#tblError').DataTable({
            responsive: false,
            bPaginate: false,
            ordering: false,
            columns: cles,
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
        });
        var errLst = {};

        function resetErrors(errs) {
            errLst = {};
            tblError.clear();
            tblError.rows.add(errs || []).draw();

            $('.errCount').html('').each(function () {
                var cnt = $(this), xml = cnt.attr('id').replace('ErrorTotal', '');
                var elst = [];
                for (var i = 0; i < errs.length; i++) {
                    if (errs[i].error_file.toLowerCase() == xml) elst.push(errs[i]);
                }
                if (elst.length) { cnt.html(elst.length); }
                errLst[xml] = elst;
            });
            $('#frmXML1 label').each(function () {
                if (!errLst || !errLst['xml1']) return;
                var lbl = $(this), par = lbl.parent(), errs = errLst['xml1'].filter(e => e.error_tag.toLowerCase() === lbl.attr('for').toLowerCase());

                $('i', par).remove();
                par.parent().removeClass('alert-row').removeClass('error-row');
                if (errs.length) {
                    var msg = errs.map(e => e.message).join(', ');
                    var desc = '';
                    try{ desc = (errs[0] && typeof errs[0].error_desc !== 'undefined') ? errs[0].error_desc : (errs[0] || ''); }catch(e){ desc = '' }
                    desc = errs.some(e => !e.is_alert) ?
                            `<i class="fas fa-exclamation-triangle error-icon ai-asking" title="${msg}" data-ai-msg="${desc}"></i>` :
                            `<i class="fas fa-exclamation-circle alert-icon ai-asking" title="${msg}" data-ai-msg="${desc}"></i>`;

                    $(desc).appendTo(par);
                    par.parent().addClass(errs.some(e => !e.is_alert) ? 'error-row' : 'alert-row');
                }
            });
        }
        function loadTable(xml, url) {
            var clms = [], fds = headCaps[xml.toLowerCase()];

            for (var i = 0; i < fds.length; i++) {
                var c = {
                    data: fds[i].toLowerCase(),
                    render: function (data, type, row, meta) {
                        var elm = headCaps[xml.toLowerCase()];
                        if (elm) { elm = elm[meta.col]; }
                        return renderCell(data, xml, elm, row);
                    }
                };
                clms.push(c);
            }

            var tbl = `#tbl${xml == 'history' ? 'History' : xml.toUpperCase()}`;
            tblXML[xml] = $(tbl).DataTable({
                responsive: false,
                processing: true,
                serverSide: true,
                ordering: false,
                searchDelay: 500,
                ajax: {
                    url: url,
                    type: 'POST',
                    data: function (d) {
                        d.xml01ID = curXml1.xml01id;
                    }
                },
                order: [],
                columns: clms,
                rowCallback: function (row, data) { renderRowError(row, data); },
                oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
                lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
            });
        }

        $('#navLinks').on('click', '.nav-link', function () {
            var self = $(this), xml = $(this).attr('href').slice(1);
            if (self.hasClass('active') || xml == 'xml1' || xml == 'error') return;

            var tbl = tblXML[xml];
            if (self.hasClass('reload')) {
                self.removeClass('reload');
                if (tbl && tbl.ajax) { tbl.ajax.reload(); }
                else { loadTable(xml, self.data('path')); }
            }
        });

        $('#tblXML1 tbody').on('dblclick', 'tr', function () {
