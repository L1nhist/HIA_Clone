            $.ajax({
                url: `@Url.Action(nameof(Files130Controller.GetXmlError), Uti.GetControllerName(nameof(Files130Controller)))?xml01ID=${curXml1.xml01id}`,
                method: 'POST',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (res) {
                    resetErrors(res);
                    $("#detailModal").modal("show");
                }
            });

            if (curXml1.ma_cskcb == "27009") {
                $.ajax({
                    url: `@Url.Action(nameof(Files130Controller.RemoveDubSingle), Uti.GetControllerName(nameof(Files130Controller)))?maLK=${curXml1.ma_lk}`,
                    method: 'POST',
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    cache: false,
                });
            }
        });


        function downloadXML() {
            if (!curXml1?.file_name || !curXml1?.ngay_tao) {
                $.toast({
                    heading: 'Cảnh báo',
