            $("#spinnerWrapper").modal("show");

            $.ajax({
                url: "@Url.Action(nameof(Files130Controller.RecheckHoso), Uti.GetControllerName(nameof(Files130Controller)))" + `?xml01ID=${curXml1.xml01id}`,
                method: 'GET',
                data: function(d) {
                    btnActiv(0);
                    d.xml01id = curXml1.xml01id;
                    return d;
                },
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function() {
                    $("#spinnerWrapper").modal("hide");
                    $("#detailModal").modal("hide");

                    $.toast({
                        heading: 'Thông báo',
                        text: 'Đã đưa hồ sơ vào hàng đợi để giám định lại, vui lòng chờ trong chốc lát.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'info',
                        hideAfter: 3500,
                        stack: 6
                    });
