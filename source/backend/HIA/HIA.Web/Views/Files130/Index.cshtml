            frH.append($('<option>', { value: i, text: i > 9 ? i : '0' +i.toString() }));
            toH.append($('<option>', { value: i, text: i > 9 ? i : '0' +i.toString() }));
        }
        for (var i = 0; i < 60; i++) {
            frM.append($('<option>', { value: i, text: i > 9 ? i : '0' +i.toString() }));
            toM.append($('<option>', { value: i, text: i > 9 ? i : '0' +i.toString() }));
        }

        function isTimeChg(e) {
            var all = $('.input-daterange input');
            var fd = '', td = '', fh = (parseInt(frH.val()) * 100 + parseInt(frM.val())) || 0, th = (parseInt(toH.val()) * 100 + parseInt(toM.val())) || 0;

            for (var i = 0; i < all.length; i++) {
                var v = all.eq(i).val();
                if (!v) continue;

                if (all[i].id.indexOf('from') > -1) {
                    fd = v;
                }
                if (all[i].id.indexOf('to') > -1) {
                    td = v;
                }
            };

            if (fd && td && fd == td && fh > th)
            {
                alert('Giờ không hợp lệ: Giờ bắt đầu phải nhỏ hơn giờ kết thúc');
                return false;
            }
            if (e.id.indexOf('from') > -1) return !!fd;
            if (e.id.indexOf('to') > -1) return !!td;
            return true;
        }
        frH.val(0).change(function (e) { if (isTimeChg(this)) callFilter(e); });
        frM.val(0).change(function (e) { if (isTimeChg(this)) callFilter(e); });
        toH.val(23).change(function (e) { if (isTimeChg(this)) callFilter(e); });
        toM.val(59).change(function (e) { if (isTimeChg(this)) callFilter(e); });

