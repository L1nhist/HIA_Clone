@using System.Security.Claims;
@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Categories;
@using HIA.Core.Models.Files;
@using HIA.Core.Models.Token;
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = DisplayFieldResource.MENU_HOSO_MAGEME + " 130";
    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER);
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.ADMIN);
    var isUser = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.USER);
    var currentMaCSKCB = User.FindFirst(ClaimKey.MA_CSKCB).Value;
}

<link rel="stylesheet" href="@Url.Content("~/lib/bootstrap-datepicker/bootstrap-datepicker.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2-bootstrap.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/elite/css/page/tab-page.css")" />
<link rel="stylesheet" type="text/css"
href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">

<style>
    .errCount {
        border-radius: 15px;
        font-size: 12px;
        color: #fff;
        background: #d00;
        padding: 3px;
        margin-top: -10px;
        position: absolute;
        display: inline-block;
        line-height: 1em;
    }

    .errCount:empty {
        display: none;
    }

    .clx {
        display: block;
        line-height: 20px;
    }

    .time-picker {
        border: solid 1px #ccc;
        border-radius: 3px;
        display: block;
        margin: 5px auto;
        padding: 3px;
        text-align: center;
    }

    .time-picker select {
        background: #ddd;
        border: none;
        color: #000;
        font-weight: bold;
        display: inline-block;
        padding: 5px 10px;
    }

    .time-picker span {
        color: #888;
        font-weight: bold;
        display: inline-block;
        padding: 5px;
    }

    .glow_space i {
        background: rgba(255,255,255,.15);
        font-style: none;
    }
    .glow_space:hover i {
        background: #ec3;
    }
</style>

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@ViewData["Title"]</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card filter-wrapper">
        <div class="card-body">
            <div class="row" id="divFilters">
                <div class="col-12 col-md-6">
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateOut">Ngày ra</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateOut" name="filterDateOut" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateOut" name="filterDateOut" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateIn">Ngày vào</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateIn" name="filterDateIn" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateIn" name="filterDateIn" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateCreate" style="max-height: unset;">Ngày tạo/<br />Chấm công</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateCreate" name="filterDateCreate" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateCreate" name="filterDateCreate" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateCreate">Ngày TT</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDatePaid" name="filterDatePaid" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDatePaid" name="filterDatePaid" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right">Chọn giờ</label>
                        <div class="input-group col-4">
                            <div class="time-picker">
                                <select name="timeRanges" id="fromHour" class="hoursel">
                                </select>
                                <span class="">:</span>
                                <select name="timeRanges" id="fromMin" class="minsel">
                                </select>
                            </div>
                        </div>
                        <div class="col-1"></div>
                        <div class="input-group col-4">
                            <div class="time-picker">
                                <select name="timeRanges" id="toHour" class="hoursel">
                                </select>
                                <span class="">:</span>
                                <select name="timeRanges" id="toMin" class="minsel">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="mb-2 select2-custom form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDepartment">Khoa</label>
                        <div class="col-9">
                            <select name="filterDepartment" id="filterDepartment" class="form-control select2 filter-change" multiple="multiple">
                                @foreach (var item in ViewBag.DepartmentList)
                                {
                                    <option value="@item.Value">@item.Text - @item.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterKCB">Loại KCB</label>
                        <div class="col-9">
                            <select name="filterKCB" id="filterKCB" class="form-control filter-change">
                                <option value="" selected>Tất cả</option>
                                <option value="01">Khám bệnh</option>
                                <option value="02">Điều trị ngoại trú</option>
                                <option value="03">Điều trị nội trú</option>
                                <option value="04">Nội trú ban ngày</option>
                                <option value="05">Ngoại trú các bệnh mãn tính dài ngày, khám bệnh và lấy thuốc</option>
                                <option value="06">Điều trị lưu tại Trạm y tế xã, phòng khám đa khoa khu vực</option>
                                <option value="07">Nhận thuốc theo hẹn</option>
                                <option value="08">Ngoại trú các bệnh mãn tính dài ngày, khám bệnh và lấy thuốc, có thực hiện các dịch vụ kỹ thuật</option>
                                <option value="09">Điều trị nội trú dưới 4h</option>
                                <option value="10">Các TH khác</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 select2-custom form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterError">Lỗi</label>
                        <div class="col-9">
                            <select name="filterError" id="filterError" class="form-control select2 filter-change" multiple="multiple">
                                @foreach (var err in ViewBag.ErrorList)
                                {
                                    <option value="@err.ErrorCode" class="error-option">
                                        [@err.ErrorAtXMLFile] @err.ErrorCode - @err.ErrorContent
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterStatus">Trạng thái</label>
                        <div class="col-9">
                            <select name="filterStatus" id="filterStatus" class="form-control filter-change">
                                <option value="0" selected>Tất cả mọi hồ sơ</option>
                                <option value="1">Chỉ hồ sơ hoàn thành</option>
                                <option value="2">Chỉ hồ sơ có lỗi</option>
                                @if (currentMaCSKCB == "27009")
                                {
                                <option value="3">Chỉ bệnh nhân ra viện</option> 
                                }
                            </select>
                        </div>
                    </div>
                    @if (isMaster == true)
                    {
                        <div class="mb-2 select2-custom form-group row">
                            <label class="lbl-filter col-3 col-form-label text-right" for="filterStatus">Bệnh viện</label>
                            <div class="col-9">
                                <select name="filterHospital" id="filterHospital" class="form-control select2 filter-change">
                                    <option value="" selected>Tất cả bệnh viện</option>
                                    @foreach (var item in ViewBag.Hospitals)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="hospitalCode" id="filterHospital" value="@currentMaCSKCB" />
                    }
                </div>
            </div>
            <div class="form-row row">
                <div class="col-12 col-md-4 mb-2">
                    <button id="toggleFilters" class="btn btn-dark btn-inline">Ẩn Bộ lọc</button>
                    @if (isAdmin == true)
                    {
                        <button id="btnDublicate" onclick="dedublicate()" class="btn btn-warning btn-inline">Xóa HS trùng</button>
                    }
                    @if (isMaster == true)
                    {
                        <button id="btnRecheck" onclick="recheckAll()" class="btn btn-warning btn-inline">Ktra lại hết</button>
                    }
                </div>
                <div class="col-12 col-md-8 mb-2 text-right">
                    <b>Tải báo cáo:</b>
                    <button onclick="downloadFile(0)" id="btnDownload0" class="btn btn-inline btn-primary btn-download">BC Tổng hợp</button>
                    <button onclick="downloadFile(1)" id="btnDownload1" class="btn btn-inline btn-primary btn-download">BC Trùng DV</button>
                    <button onclick="downloadFile(2)" id="btnDownload2" class="btn btn-inline btn-primary btn-download">BC Thuốc & VT</button>
                    <button onclick="downloadFile(3)" id="btnDownload3" class="btn btn-inline btn-primary btn-download">BC Chỉ định</button>
                    <div class="clearfix" style="height: 10px;"></div>
                    <button onclick="downloadFile(5)" id="btnDownload5" class="btn btn-inline btn-primary btn-download">BC Trùng XML4</button>
                    <button onclick="downloadFile(4)" id="btnDownload4" class="btn btn-inline btn-primary btn-download">Thống kê lỗi</button>
                    <button onclick="downloadFile(6)" id="btnDownload6" class="btn btn-inline btn-primary btn-download">Chấm công</button>
                </div>
            </div>
        </div>
    </div>
    <div class="card files-wrapper">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom file-management">
                <table class="table table-bordered table-striped table-data" id="tblXML1">
                    <thead>
                        <tr></tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

