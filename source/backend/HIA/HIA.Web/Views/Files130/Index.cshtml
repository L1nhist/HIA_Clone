                url: "@Url.Action(nameof(Files130Controller.GetXML01), Uti.GetControllerName(nameof(Files130Controller)))",
                type: 'POST',
                data: function (d) {
                    x1idx = 0;
                    d.filterDateIns = [$("#fromDateIn").val(), $('#toDateIn').val()];
                    d.filterDateOuts = [$("#fromDateOut").val(), $('#toDateOut').val()];
