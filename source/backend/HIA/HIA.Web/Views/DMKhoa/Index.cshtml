@using HIA.Core.Languages.DisplayField;
@using HIA.Core.Languages.TitlePage;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Categories;

@{
    ViewData["Title"] = DisplayFieldResource.MENU_DEPARTMENT_MAGEME;
    var modelDisplay = new DMKhoaInfoModel();
}

<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">
<link rel="stylesheet" href="@Url.Content("~/lib/elite/libs/dropify/dropify.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@DisplayFieldResource.MENU_DEPARTMENT_MAGEME</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.MENU_DEPARTMENT_MAGEME</li>
                </ol>
                <a href="@Url.Action(nameof(DMKhoaController.Create), Uti.GetControllerName(nameof(DMKhoaController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="row handle-file">
                <div class="col-8">
                    <div class="upload-file-wrapper row">
                        <div class="col-10 drop-wrapper">
                            <h6>@DisplayFieldResource.TITLE_UPLOAD_CATEGORY</h6>
                            <input type="file" id="fileupload" class="dropify" data-allowed-file-extensions='["xls", "xlsx"]' />
                        </div>
                        <div class="col-2 button-wrapper">
                            <button type="button" class="btn btn-block btn-outline-info" onclick="uploadFile()">@DisplayFieldResource.UPLOAD_TEXT</button>
                        </div>
                    </div>
                </div>
                <div class="col-4 download-file-wrapper">
                    <div class="row justify-content-end h-100">
                        <div class="col-4">
                            <a onclick="downloadFile()" id="btnDownload" class="btn btn-block btn-outline-success display-flex" href="#">
                                <span class="flex-middle">@DisplayFieldResource.DOWNLOAD_TEXT</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive fixed-table-custom has-upload fixed-column">
                <table class="stripe table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.NO</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.KhoaCode)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.KhoaName)</th>
                            <th>@DisplayFieldResource.ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_spinnerPartial" />
@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/dataTables.fixedColumns.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/dropify/dropify.min.js")"></script>
    <script>
        $('.dropify').dropify();
        function calcDataTableHeight() {
            /*68px: header, 43px: title, 10px: mgbttom-top, 20px: 2 paddtop-bot 10; 92px: upload, 32px: footer, 10px: bottom margin*/
            const height = $(window).height() - 68 - 43 - 10 - 20 - 92 - 32 - 10 - 120;
            return height;
        }
        const dataTbl = $('#tbl_DataTable').DataTable({
            responsive: false,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(DMKhoaController.GetItems), Uti.GetControllerName(nameof(DMKhoaController)))",
                type: 'POST',
            },
            language: {
                "search": "",
                "searchPlaceholder": "Search..."
            },
            columnDefs: [
                { width: 100, targets: "_all" }
            ],
            order: [[1, "asc"]], // set default sort is column 1
            columns: [
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.KhoaCode))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.KhoaName))" },
                {
                    render: function (data, type, row, meta) {
                        const editUrl = '@Url.Action(nameof(DMKhoaController.Edit), Uti.GetControllerName(nameof(DMKhoaController)))' + `?id=${row.khoaID}`;
                        const delUrl = '@Url.Action(nameof(DMKhoaController.DeleteAction), Uti.GetControllerName(nameof(DMKhoaController)))' + `?id=${row.khoaID}`;
                        return `<a href="${editUrl}" class="edit-icon"><i class="icon-note"></i></a> <a href="${delUrl}" class="del-icon"><i class="icon-trash"></i></a>`;
                    }
                },
            ],
            scrollX: true,
            sScrollY: calcDataTableHeight(),
            scrollCollapse: true,
            fixedColumns: {
                leftColumns: 0,
                rightColumns: 1,
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });
        
        function uploadFile() {
            const fileExtension = ['xls', 'xlsx'];
            const filename = $('#fileupload').val();

            if (filename.length == 0) return;


            const extension = filename.replace(/^.*\./, '');
            if ($.inArray(extension, fileExtension) == -1) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select only excel files.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return ;
            }

            const fileUpload = $("#fileupload").get(0);
            const file = fileUpload.files[0];
            const maxSize = 10 * 1024 * 1024;
            if (!file || file.size > maxSize) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select file smaller 10Mb.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return;
            }
            var fdata = new FormData();
            fdata.append(file.name, file);
            $("#spinnerWrapper").modal("show");
            $.ajax({
                type: "POST",
                url: "@Url.Action(nameof(DMKhoaController.Upload), Uti.GetControllerName(nameof(DMKhoaController)))",
                data: fdata,
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    if (response?.code !== 200) {
                        $.toast({
                            heading: 'Upload Fail',
                            text: 'Some error occured while uploading - ' + response.message,
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    dataTbl.ajax.reload();
                    $(".dropify-clear").trigger("click");
                    $.toast({
                        heading: 'Upload success',
                        text: '',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 2000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $.toast({
                        heading: 'Upload Fail',
                        text: 'Some error occured while uploading',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function downloadFile() {
            $("#btnDownload").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");
            $.ajax({
                url: "@Url.Action(nameof(DMKhoaController.GetDownloadData), Uti.GetControllerName(nameof(DMKhoaController)))",
                method: "GET",
                contentType: "application/json",
                cache: false,
                success: function (response) {
                    if (response.code != 200) {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(DMKhoaController.Download), Uti.GetControllerName(nameof(DMKhoaController)))' + `?fileGuid=${response.data.fileGuid}&fileName=${response.data.fileName}`;
                    setTimeout(() => {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');

                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 2000,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
    </script>
}
