@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.User;

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="staticBackdropLabel">@DisplayFieldResource.CHANGE_PASS</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <form class="form-horizontal" id="changePassform" asp-action="@nameof(AuthController.ChangePassword)" asp-controller="@Uti.GetControllerName(nameof(AuthController))">
            <div class="modal-body">
                <div class="form-group">
                    <label for="@nameof(ChangePassword.CurrentPassword)" class="control-label">@DisplayFieldResource.CURRENT_PASSWORD</label>
                    <input name="@nameof(ChangePassword.CurrentPassword)" id="@nameof(ChangePassword.CurrentPassword)" type="password" class="form-control" />
                    <span id="CurrentPasswordError" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="@nameof(ChangePassword.NewPassword)" class="control-label">@DisplayFieldResource.NEW_PASSWORD</label>
                    <input name="@nameof(ChangePassword.NewPassword)" id="@nameof(ChangePassword.NewPassword)"  type="password" class="form-control" />
                    <span id="NewPasswordError" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="@nameof(ChangePassword.ConfirmPassword)" class="control-label">@DisplayFieldResource.CONFIRM_PASSWORD</label>
                    <input name="@nameof(ChangePassword.ConfirmPassword)" id="@nameof(ChangePassword.ConfirmPassword)" type="password" class="form-control" />
                    <span id="ConfirmPasswordError" class="text-danger"></span>
                </div>
                <div id="CommonError" class="text-danger"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCloseChangePass" class="btn btn-secondary" data-dismiss="modal">@DisplayFieldResource.CLOSE</button>
                <button onclick="changePassword('@nameof(Model.CurrentPassword)', '@nameof(Model.NewPassword)', '@nameof(Model.ConfirmPassword)', 'Common', '@Url.Action(nameof(AuthController.ChangePassword), Uti.GetControllerName(nameof(AuthController)))')"
                        type="button" class="btn btn-primary">
                    @DisplayFieldResource.UPDATE_1
                </button>
            </div>
        </form>
    </div>
</div>

@*SCRIPT IN site.js*@
