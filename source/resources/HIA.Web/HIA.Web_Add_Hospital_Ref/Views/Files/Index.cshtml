        // custom filter
        @*Linhist changed 10/06/22*@
        var tmrFilter = 0;
        function callFilter(event) {
            event.preventDefault();
            event.stopPropagation();

            if (tmrFilter) { clearTimeout(tmrFilter); tmrFilter = 0; }
            tmrFilter = setTimeout(function () {
                dataTbl.ajax.reload();
            }, 500);
        }

        // show modal
        function setErrorTotalForTab(dataLength, eleId) {
            if (dataLength === 0) return;

            $(`#${eleId}`).removeClass("xml-text-color error valid");
            const eleColorClass = dataLength > 0 ? "xml-text-color error" : "xml-text-color valid";
            $(`#${eleId}`).addClass(eleColorClass);

            const bTag = document.createElement("b");
            bTag.innerText  = dataLength;
            $(`#${eleId}`).append("(@DisplayFieldResource.LABEL_HAS ");
            $(`#${eleId}`).append(bTag);
            $(`#${eleId}`).append(" @DisplayFieldResource.LABEL_ERROR)");
        }
        function clearErrTotalForTab() {
            $(`#xml1ErrorTotal`).html('');
            $(`#xml2ErrorTotal`).html('');
            $(`#xml3ErrorTotal`).html('');
            $(`#xml4ErrorTotal`).html('');
            $(`#xml5ErrorTotal`).html('');
        }
        $('#tbl_DataTable tbody').on('dblclick', 'tr', function () {
            xml1Data = dataTbl.row(this).data();
            currentXml1Id = xml1Data.xmL1ID;
            $.ajax({
                url: "@Url.Action(nameof(FilesController.GetItemsXml1Error), Uti.GetControllerName(nameof(FilesController)))" + `?xml1Id=${currentXml1Id}`,
                method: 'GET',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (res) {
                    if (!res) return;
                    clearErrTotalForTab();
                    $("#tbl_xml1Error_wrapper").html(res.partialView);
                    $("#detailModal").modal("show");

                    errorList = res.data;

