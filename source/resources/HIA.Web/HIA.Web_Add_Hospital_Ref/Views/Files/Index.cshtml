        function getXml1Modal() {
             $.ajax({
                url: "@Url.Action(nameof(FilesController.TransformDataToPartialXml1), Uti.GetControllerName(nameof(FilesController)))",
                method: 'POST',
                data: JSON.stringify({
                    xml1Data,
                    errorList,
                }),
                dataType: 'text',
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (data) {
                    if (!data) return;

                    $("#xml1").html(data);
                },
                fail: function (jqXHR, textStatus) {
                    alert("Request failed: " + textStatus);
                }
            });
        }

        function getCellErrMes(xmlFileName, propertyName, sttNameField, row) {
            let result = '';
            if (!errorList?.length) return result;
            const errors = errorList.filter(x =>
                x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === xmlFileName
                && x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.XeErrorRow))'] === row[sttNameField]
                && x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLTag))'].toLowerCase() === propertyName.toLowerCase());
            if (!errors?.length) return result;

            result = errors.map(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorContent))']).join(', ');
            return result;
        }

        function renderCell(data, xmlFileName, propertyName, sttNameField, row) {
            const mes = getCellErrMes(xmlFileName, propertyName, sttNameField, row);
            return mes
                ? `${data} <i class="fas fa-exclamation-triangle error-icon" title="${mes}"></i>`
                : data;
        }

