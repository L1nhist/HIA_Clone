<div class="container-fluid container-report">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@TitlePageResource.REPORT_TITLE</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@TitlePageResource.REPORT_TITLE</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card filter-wrapper">
        <div class="card-body">
            <div class="form-row row">
                <div class="col-12 col-md-5 mb-2 form-group row">
                    <label class="lbl-filter col-2 col-form-label text-right" for="filterDay">Từ ngày</label>
                    <div class="input-daterange input-group col-10" id="datepicker">
                        <input id="filterFromDate" type="text" class="custom-daterange form-control left-control" name="filterFromDate" placeholder="dd/mm/yyyy" />
                        <span class="input-group-text custom-group-text">Đến ngày</span>
                        <input id="filterToDate" type="text" class="custom-daterange form-control right-control" name="filterToDate" placeholder="dd/mm/yyyy" />
                    </div>
                </div>
                <div class="col-12 col-md-5 mb-2 select2-custom form-group row">

                </div>
            </div>
        </div>
    </div>

    <div class="chart-wrapper report-wrapper" id="chartContainer"></div>
    <div class="chart-wrapper report-wrapper" id="chartContainer2"></div>
</div>

