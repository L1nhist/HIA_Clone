@using HIA.Core.Languages.DisplayField;
@using HIA.Core.Languages.TitlePage;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@model HIA.Core.Models.Categories.DMBacSiModifyModel

@{
    ViewData["Title"] = TitlePageResource.DM_NHAN_VIEN;
}

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@TitlePageResource.DM_NHAN_VIEN</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(DMBacSiController.Index), Uti.GetControllerName(nameof(DMBacSiController)))">@TitlePageResource.DM_NHAN_VIEN</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.DELETE</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <form asp-action="@nameof(DMBacSiController.DeleteAction)">
                <dl class="row">
                    @Html.HiddenFor(model => model.BacSiID)
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.MaNhanVien)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.MaNhanVien)
                        @Html.HiddenFor(model => model.MaNhanVien)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Ten_NHANVIEN)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Ten_NHANVIEN)
                        @Html.HiddenFor(model => model.Ten_NHANVIEN)
                    </dd>
                </dl>


                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="submit" value="@DisplayFieldResource.DELETE" class="btn btn-danger" /> |
                <a asp-action="@nameof(DMBacSiController.Index)">@DisplayFieldResource.BACK_TO_LIST</a>
            </form>
        </div>
    </div>
</div>

