@using HIA.Core.Languages.TitlePage;
@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;

@model HIA.Core.Models.User.ResetPassModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")">
    <title>@TitlePageResource.NEW_PASS - @TitlePageResource.WEBSITE_NAME</title>

    <link href="@Url.Content("~/lib/elite/css/page/login-register-lock.css")" rel="stylesheet">
    <link href="@Url.Content("~/lib/elite/css/style.min.css")" rel="stylesheet">
</head>
<body>
    <div class="preloader">
        <div class="loader">
            <div class="loader__figure"></div>
            <p class="loader__label">Loading Data...</p>
        </div>
    </div>

    <section id="wrapper">
        <div class="login-register" style="background-image:url(@Url.Content("~/lib/elite/images/background/7.jpg"));">
            <div class="login-box card">
                <div class="card-body">
                    <form class="form-horizontal form-material" id="updatePassform" asp-action="@nameof(AuthController.ResetPassword)">
                        @Html.HiddenFor(model => model.Token)
                        <h3 class="text-center m-b-20">@DisplayFieldResource.PASSWORD</h3>
                        <div class="form-group">
                            <div class="col-xs-12">
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="@DisplayFieldResource.PASSWORD" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-xs-12">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="@DisplayFieldResource.CONFIRM_PASSWORD" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group text-center">
                            <div class="col-xs-12 p-b-20">
                                <input type="submit" value="@DisplayFieldResource.UPDATE_1" class="btn btn-block btn-lg btn-info btn-rounded" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.min.js")"></script>
    <script type="text/javascript">
        $(function () {
            $(".preloader").fadeOut();
        });
    </script>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>
