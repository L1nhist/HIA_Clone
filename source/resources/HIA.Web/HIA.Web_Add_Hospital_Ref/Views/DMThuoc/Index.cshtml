@using HIA.Core.Languages.DisplayField;
@using HIA.Core.Languages.TitlePage;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Categories;

@{
    ViewData["Title"] = TitlePageResource.DM_THUOC_TITLE;
    var modelDisplay = new DMThuocInfoModel();
}

<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">
<link rel="stylesheet" href="@Url.Content("~/lib/elite/libs/dropify/dropify.min.css")">

<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@TitlePageResource.DM_THUOC_TITLE</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@TitlePageResource.DM_THUOC_TITLE</li>
                </ol>
                <a href="@Url.Action(nameof(DMThuocController.Create), Uti.GetControllerName(nameof(DMThuocController)))" class="btn btn-light d-none d-lg-block m-l-15 btn-add">
                    <i class="fa fa-plus-circle"></i> @DisplayFieldResource.CREATE_NEW
                </a>
            </div>
        </div>
    </div>
    <div class="card upload-file-wrapper">
        <div class="card-body">
            <div class="row handle-file display-flex">
                <div class="col-10 drop-wrapper">
                    <input type="file" id="fileupload" class="dropify " data-allowed-file-extensions='["xls", "xlsx"]' />
                </div>
                <div class="col-2 button-wrapper flex-middle">
                    <button type="button" class="btn btn-block btn-info" onclick="uploadFile()"><i class="icon-cloud-upload"></i> @DisplayFieldResource.UPLOAD_TEXT</button>
                    <button type="button" onclick="downloadFile()" id="btnDownload" class="btn btn-block btn-primary"><i class="icon-cloud-download"></i> @DisplayFieldResource.DOWNLOAD_TEXT</button>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom has-upload fixed-column">
                <table class="stripe table table-bordered table-striped" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@DisplayFieldResource.NO</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.ThuocID)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ten_THUOC)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.ThuocMHTCID)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_HOAT_CHAT)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Hoat_CHAT)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Hoatchat_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_DUONG_DUNG)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_DUONGDUNG_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Duong_DUNG)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.DuongDung_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ham_LUONG)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Hamluong_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Tenthuoc_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.SO_DANG_KY)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Sodangky_AX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Dong_GOI)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_VI_TINH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_GIA)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Don_GIA_TT)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Gia_TRAN)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.SO_LUONG)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_CSKCB)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Hang_SX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nuoc_SX)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nha_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Quyet_DINH)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Cong_BO)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MA_THUOC_BV)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Loai_THUOC)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Goi_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Loai_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Nhom_THAU)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.MaNHOM_5937)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Manhom_9324)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Hieuluc)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Ketqua)</th>
                            <th>@Html.DisplayNameFor(x => modelDisplay.Lydotuchoi)</th>
                            <th>@DisplayFieldResource.ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_spinnerPartial" />
@section Scripts {
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/dataTables.fixedColumns.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/dropify/dropify.min.js")"></script>
    <script>
        $('.dropify').dropify({
            messages: @Html.Raw(DropifySettingDefault.MESSAGES),
            error: @Html.Raw(DropifySettingDefault.ERROR),
        });
        function calcDataTableHeight() {
            /*68px: header, 37px: title, 5px: mgbttom-top, 106: upload, 20px: 2 paddtop-bot 10; 32px: footer, 10px: bottom margin*/
            const height = $(window).height() - 68 - 37 - 5 - 106 - 20 - 32 - 5 - 120;
            return height;
        }
        const dataTbl = $('#tbl_DataTable').DataTable({
            responsive: false,
            processing: true,
            serverSide: true,
            searchDelay: 500,
            ajax: {
                url: "@Url.Action(nameof(DMThuocController.GetItems), Uti.GetControllerName(nameof(DMThuocController)))",
                type: 'POST',
            },
            columnDefs: [
                { width: 100, targets: "_all" }
            ],
            order: [[1, "asc"]], // set default sort is column 1
            columns: [
                {
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.ThuocID))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Ten_THUOC))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.ThuocMHTCID))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_HOAT_CHAT))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Hoat_CHAT))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Hoatchat_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_DUONG_DUNG))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_DUONGDUNG_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Duong_DUNG))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.DuongDung_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Ham_LUONG))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Hamluong_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Tenthuoc_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.SO_DANG_KY))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Sodangky_AX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Dong_GOI))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Don_VI_TINH))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Don_GIA))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Don_GIA_TT))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Gia_TRAN))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.SO_LUONG))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_CSKCB))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Hang_SX))", className: "w-200" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Nuoc_SX))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Nha_THAU))", className: "w-650" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Quyet_DINH))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Cong_BO))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MA_THUOC_BV))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Loai_THUOC))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Goi_THAU))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Loai_THAU))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Nhom_THAU))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.MaNHOM_5937))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Manhom_9324))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Hieuluc))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Ketqua))" },
                { data: "@Uti.SetLowerCaseFirstChar(nameof(modelDisplay.Lydotuchoi))" },
                {
                    render: function (data, type, row, meta) {
                        const editUrl = '@Url.Action(nameof(DMThuocController.Edit), Uti.GetControllerName(nameof(DMThuocController)))' + `?id=${row.thuocID}`;
                        const delUrl = '@Url.Action(nameof(DMThuocController.DeleteAction), Uti.GetControllerName(nameof(DMThuocController)))' + `?id=${row.thuocID}`;
                        return `<a href="${editUrl}" class="edit-icon"><i class="icon-note"></i></a> <a href="${delUrl}" class="del-icon"><i class="icon-trash"></i></a>`;
                    }
                },
            ],
            scrollX: true,
            sScrollY: calcDataTableHeight(),
            scrollCollapse: true,
            fixedColumns: {
                leftColumns: 0,
                rightColumns: 1,
            },
            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
            lengthMenu: @Html.Raw(@DataTableSettingDefault.LENGTH_MENU),
        });
        function uploadFile() {
            const fileExtension = ['xls', 'xlsx'];
            const filename = $('#fileupload').val();

            if (filename.length == 0) return;


            const extension = filename.replace(/^.*\./, '');
            if ($.inArray(extension, fileExtension) == -1) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select only excel files.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return ;
            }

            const fileUpload = $("#fileupload").get(0);
            const file = fileUpload.files[0];
            const maxSize = 10 * 1024 * 1024;
            if (!file || file.size > maxSize) {
                $.toast({
                    heading: 'Add file Fail',
                    text: 'Please select file smaller 10Mb.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 2000,
                    stack: 6
                });
                return;
            }
            var fdata = new FormData();
            fdata.append(file.name, file);
            $("#spinnerWrapper").modal("show");
            $.ajax({
                type: "POST",
                url: "@Url.Action(nameof(DMThuocController.Upload), Uti.GetControllerName(nameof(DMThuocController)))",
                data: fdata,
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    if (response?.code !== 200) {
                        $.toast({
                            heading: 'Upload Fail',
                            text: 'Some error occured while uploading - ' + response.message,
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    dataTbl.ajax.reload();
                    $(".dropify-clear").trigger("click");
                    $.toast({
                        heading: 'Upload success',
                        text: '',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'success',
                        hideAfter: 2000,
                        stack: 6
                    });
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $.toast({
                        heading: 'Upload Fail',
                        text: 'Some error occured while uploading',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
        function downloadFile() {
            $("#btnDownload").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");
            $.ajax({
                url: "@Url.Action(nameof(DMThuocController.GetDownloadData), Uti.GetControllerName(nameof(DMThuocController)))",
                method: "GET",
                contentType: "application/json",
                cache: false,
                success: function (response) {
                    if (response.code != 200) {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 2000,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(DMThuocController.Download), Uti.GetControllerName(nameof(DMThuocController)))' + `?fileGuid=${response.data.fileGuid}&fileName=${response.data.fileName}`;
                    setTimeout(() => {
                        $("#spinnerWrapper").modal("hide");
                        $("#btnDownload").removeClass('disabled-custom');

                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 2000,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');
                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 2000,
                        stack: 6
                    });
                }
            });
        }
    </script>
}
