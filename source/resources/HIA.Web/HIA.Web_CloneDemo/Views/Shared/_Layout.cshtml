@using System.Security.Claims;
@using HIA.Core.Languages.TitlePage;
@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Token;

@{
    string WebsiteName = TitlePageResource.WEBSITE_NAME;
    WebsiteName = "MDInsight";

    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER);
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.ADMIN);
    var isUser = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.USER);
    var isBoyte = User.FindFirst(ClaimKey.MA_CSKCB)?.Value == "BOYTE";
    var hospitalName = User.FindFirst(ClaimKey.MA_CSKCB)?.Value + "   " + User.FindFirst(ClaimKey.HOSPITAL_NAME)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hệ thống Quản trị dữ liệu thanh toán bảo hiểm y tế">
    <meta name="author" content="@WebsiteName">

    <link rel="apple-touch-icon" sizes="144x144" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">


    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon/favicon.ico")">
    <title>@ViewData["Title"] - @WebsiteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600;1,700&display=swap" rel="stylesheet">

    <link href="@Url.Content("~/lib/elite/css/style.min.css")" rel="stylesheet">

    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link href="@Url.Content("~/lib/elite/libs/toast/jquery.toast.css")" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/common.min.css?new=ww3ew")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css?n=safw3432")" />
</head>
<body class="skin-blue-dark fixed-layout">
    <div class="preloader">
        <div class="loader">
            <div class="loader__figure"></div>
            <p class="loader__label">@DisplayFieldResource.LABEL_LOADING</p>
        </div>
    </div>

    <div id="main-wrapper">
        <header class="topbar">
            <nav class="navbar top-navbar navbar-expand-md navbar-dark">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link sidebartoggler d-none d-lg-block d-md-block waves-effect waves-dark" href="javascript:void(0)"><i class="icon-menu"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="navbar-brand" href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">
                            <img src="@Url.Content("~/imgs/logo-bo-y-te.png")" alt="homepage" class="logo" />
                            <h1>Hệ thống Quản trị dữ liệu<br />thanh toán bảo hiểm y tế</h1>
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav my-lg-0">
                    <li class="nav-item dropdown u-pro">
                        <a class="nav-link dropdown-toggle waves-effect waves-dark profile-pic" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><img src="/imgs/profile.png" alt="user" class=""> <span class="hidden-md-down">@User.FindFirst(ClaimKey.FULL_NAME)?.Value &nbsp;<i class="fa fa-angle-down"></i></span> </a>
                        <div class="dropdown-menu dropdown-menu-right animated flipInY">
                            <div class="dropdown-item">
                                @DisplayFieldResource.EMAIL: <b>@User.FindFirst(ClaimTypes.NameIdentifier)?.Value</b>
                            </div>
                            <div class="dropdown-item">
                                @DisplayFieldResource.HOSPITAL: <b>@User.FindFirst(ClaimKey.HOSPITAL_NAME)?.Value</b>
                            </div>
                            <div class="dropdown-item">
                                @DisplayFieldResource.ROLE: <b>@User.FindFirst(ClaimKey.ROLE_NAME)?.Value</b>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="javascript:void(0)" class="dropdown-item" data-toggle="modal" data-target="#changePassModal"><i class="ti-settings"></i> @DisplayFieldResource.CHANGE_PASS</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="@Url.Action(nameof(AuthController.SignOutAction), Uti.GetControllerName(nameof(AuthController)))"><i class="fa fa-power-off"></i> @DisplayFieldResource.SIGN_OUT</a>
                        </div>
                    </li>
                </ul>
            </nav>
        </header>

        <aside class="left-sidebar">
            <!-- Sidebar scroll-->
            <div class="scroll-sidebar">
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav">
                    <ul id="sidebarnav">

                        <li>
                            <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="fa fa-h-square"></i><span class="hide-menu">Quản lý hồ sơ</span></a>
                            <ul aria-expanded="false" class="collapse">
                                @*<li><a href="@Url.Action(nameof(FilesController.Index), Uti.GetControllerName(nameof(FilesController)))"><i class="fa fa-caret-right"></i>Thống kê lỗi</a></li>
                                <li><a href="@Url.Action(nameof(FileUploadController.Index), Uti.GetControllerName(nameof(FileUploadController)))"><i class="fa fa-caret-right"></i>Cập nhật hồ sơ</a></li>
                                <li><a href="@Url.Action(nameof(FileDownloadController.Index), Uti.GetControllerName(nameof(FileDownloadController)))"><i class="fa fa-caret-right"></i>Tải báo cáo</a></li>*@
                            </ul>
                        </li>
                        <li>
                            <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="icon-layers"></i><span class="hide-menu">Danh Mục</span></a>
                            <ul aria-expanded="false" class="collapse">
                                <li><a href="@Url.Action(nameof(DMThuocController.Index), Uti.GetControllerName(nameof(DMThuocController)))"><i class="fa fa-caret-right"></i>Thuốc</a></li>
                                <li><a href="@Url.Action(nameof(DMVTYTController.Index), Uti.GetControllerName(nameof(DMVTYTController)))"><i class="fa fa-caret-right"></i>Vật tư y tế</a></li>
                                <li><a href="@Url.Action(nameof(DMDichVuController.Index), Uti.GetControllerName(nameof(DMDichVuController)))"><i class="fa fa-caret-right"></i>Dịch vụ</a></li>
                                <li><a href="@Url.Action(nameof(DMBacSiController.Index), Uti.GetControllerName(nameof(DMBacSiController)))"><i class="fa fa-caret-right"></i>Danh Mục Nhân Viên</a></li>

                                @if (!!isAdmin.Value)
                                {
                                    @*<li><a href="@Url.Action(nameof(DMErrorController.Index), Uti.GetControllerName(nameof(DMErrorController)))"><i class="fa fa-caret-right"></i>Danh Mục Lỗi</a></li>*@
                                    <li><a href="@Url.Action(nameof(DMKhoaBVController.Index), Uti.GetControllerName(nameof(DMKhoaBVController)))"><i class="fa fa-caret-right"></i>Danh Mục Khoa</a></li>
                                    <li><a href="@Url.Action(nameof(DMKhoaBVController.List), Uti.GetControllerName(nameof(DMKhoaBVController)))"><i class="fa fa-caret-right"></i>Danh Mục Khoa Mới</a></li>

                                }

                            </ul>
                        </li>

                        @*if (isMaster == true || isAdmin == true)
                        {
                            <li>
                                <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="fas fa-cogs"></i><span class="hide-menu">Quy trình kỹ thuật</span></a>
                                <ul aria-expanded="false" class="collapse">
                                    <li><a class="waves-effect waves-dark" href="@Url.Action(nameof(HDSDThuocController.Index), Uti.GetControllerName(nameof(HDSDThuocController)))"><i class="fa fa-caret-right"></i>HDSD Thuốc</a></li>
                                </ul>
                            </li>
                        }*@

                        @if (!!isMaster.Value)
                        {
                            <li>
                                <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="fas fa-users-cog"></i><span class="hide-menu">Quản trị hệ thống</span></a>
                                <ul aria-expanded="false" class="collapse">
                                    <li><a class="waves-effect waves-dark" href="@Url.Action(nameof(UserController.Index), Uti.GetControllerName(nameof(UserController)))"><i class="fa fa-caret-right"></i>Quản lý người dùng</a></li>
                                    <li>
                                        <a class="waves-effect waves-dark" href="@Url.Action(nameof(HospitalController.Index), Uti.GetControllerName(nameof(HospitalController)))"><i class="fa fa-caret-right"></i>Quản lý bệnh viện</a>
                                    </li>
                                </ul>
                            </li>

                        }else if (isBoyte)
                        {
                            <li>
                                <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="fas fa-users-cog"></i><span class="hide-menu">Quản trị hệ thống</span></a>
                                <ul aria-expanded="false" class="collapse">
                                    <li><a class="waves-effect waves-dark" href="@Url.Action(nameof(UserController.Index), Uti.GetControllerName(nameof(UserController)))"><i class="fa fa-caret-right"></i>Quản lý người dùng</a></li>
                                    <li>
                                        <a class="waves-effect waves-dark" href="@Url.Action(nameof(HospitalController.Index), Uti.GetControllerName(nameof(HospitalController)))"><i class="fa fa-caret-right"></i>Quản lý bệnh viện</a>
                                    </li>
                                </ul>
                            </li>

                        }
                        else if (!!isAdmin.Value)
                        {
                            <li>
                                <a class="has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false"><i class="fas fa-users-cog"></i><span class="hide-menu">Quản trị hệ thống</span></a>
                                <ul aria-expanded="false" class="collapse">
                                    <li>
                                        <a class="waves-effect waves-dark" href="@Url.Action(nameof(UserController.Index), Uti.GetControllerName(nameof(UserController)))"><i class="fa fa-caret-right"></i>Quản lý người dùng</a>
                                    </li>

                                </ul>
                            </li>

                        }
                        @*<li>
                            <a class="waves-effect waves-dark" href="@Url.Action(nameof(ReportController.Index), Uti.GetControllerName(nameof(ReportController)))" aria-expanded="false"><i class="far fa-chart-bar"></i><span class="hide-menu">Báo cáo thống kê</span></a>
                        </li>

                        <li>
                            <a class="waves-effect waves-dark" href="@Url.Action(nameof(FilesController.DownloadClientInstall), Uti.GetControllerName(nameof(FilesController)))" aria-expanded="false"><i class="fa fa-download"></i><span class="hide-menu">Tải tiện ích</span></a>
                        </li>*@
                    </ul>



                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </aside>

        <div class="page-wrapper">
            @RenderBody()
        </div>

        <footer class="footer">
            Mã CSKCB:  <b>@hospitalName</b>
        </footer>
    </div>
    <div class="modal fade" id="changePassModal" data-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <partial name="_ChangePasswordPartial" />
    </div>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/popper/popper.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/popper/popper.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/js/perfect-scrollbar.jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/js/waves.js")"></script>
    <script src="@Url.Content("~/lib/elite/js/sidebarmenu.js")"></script>
    <script src="@Url.Content("~/lib/elite/js/custom.js?new=123")"></script>
    <script src="@Url.Content("~/lib/elite/libs/toast-master/js/jquery.toast.js")"></script>

    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
