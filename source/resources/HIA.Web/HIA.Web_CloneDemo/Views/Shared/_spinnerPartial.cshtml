@using HIA.Core.Languages.DisplayField;

<div id="spinnerWrapper" class="modal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="display: none;" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="display: flex; height: 100vh; margin: auto; padding: 0; justify-content: center; position: relative">
        <div class="spinner-grow text-secondary" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>


        <div class="spinner-grow text-light" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-cyan" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-success" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-danger" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-warning" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-info" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-dark" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
        <div class="spinner-grow text-purple" style="width: 3rem; height: 3rem; align-self: center;" role="status">
            <span class="sr-only">Loading...</span>
        </div>


        <div style="position: absolute; top: 55%; color: #ffffff; font-weight: bold; font-size: 24px">
            @DisplayFieldResource.LABEL_LOADING
        </div>
    </div>
</div>