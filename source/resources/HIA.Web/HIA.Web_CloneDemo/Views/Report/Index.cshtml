<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@DisplayFieldResource.MENU_HOSO_MAGEME</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.MENU_HOSO_MAGEME</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card filter-wrapper">
        <div class="card-body">
            <div class="row" id="divFilters">
                <div class="col-12 col-md-6">
                    <div class="mb-2 form-group row" style="display:none;">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateOut">Ngày ra</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateOut" name="filterDateOut" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateOut" name="filterDateOut" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row" style="display:none;">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateIn">Ngày vào</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateIn" name="filterDateIn" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateIn" name="filterDateIn" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateCreate">Ngày tạo</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDateCreate" name="filterDateCreate" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDateCreate" name="filterDateCreate" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDateCreate">Ngày TT</label>
                        <div class="input-daterange input-group col-9" id="datepicker">
                            <input id="fromDatePaid" name="filterDatePaid" type="text" class="custom-daterange form-control left-control filter-change" placeholder="dd/mm/yyyy" />
                            <span class="input-group-text custom-group-text">đến</span>
                            <input id="toDatePaid" name="filterDatePaid" type="text" class="custom-daterange form-control right-control filter-change" placeholder="dd/mm/yyyy" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="mb-2 select2-custom form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterDepartment">Khoa</label>
                        <div class="col-9">
                            <select name="filterDepartment" id="filterDepartment" class="form-control select2 filter-change" multiple="multiple">
                                @foreach (var item in ViewBag.DepartmentList)
                                {
                                    <option value="@item.Value">@item.Text - @item.Value</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 form-group row">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterKCB">Loại KCB</label>
                        <div class="col-9">
                            <select name="filterKCB" id="filterKCB" class="form-control filter-change">
                                <option value="0" selected>Tất cả</option>
                                <option value="1">Khám bệnh</option>
                                <option value="2">Điều trị ngoại trú</option>
                                <option value="3">Điều trị nội trú</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 select2-custom form-group row" style="display:none;">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterError">Lỗi</label>
                        <div class="col-9">
                            <select name="filterError" id="filterError" class="form-control select2 filter-change" multiple="multiple">
                                @foreach (var item in ViewBag.ErrorList)
                                {
                                    <option value="@item.Value" class="@(item.Quantity > 0 ? "error-option" : "")">
                                        @item.Value - @item.Text
                                        @if (item.Quantity > 0)
                                        {
                                            <b>(@item.Quantity)</b>
                                        }
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 form-group row" style="display:none;">
                        <label class="lbl-filter col-3 col-form-label text-right" for="filterStatus">Trạng thái</label>
                        <div class="col-9">
                            <select name="filterStatus" id="filterStatus" class="form-control filter-change">
                                <option value="0" selected>Tất cả mọi hồ sơ</option>
                                <option value="1">Chỉ hồ sơ hoàn thành</option>
                                <option value="2">Chỉ hồ sơ có lỗi</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-row row">
