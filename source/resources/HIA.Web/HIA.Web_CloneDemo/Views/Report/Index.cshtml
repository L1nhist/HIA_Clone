    <script type="text/javascript">
        $('.select2').select2({ theme: "bootstrap" });
        var datePickrs = $('.input-daterange');
        datePickrs.datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            clearBtn: true,
        }).on('changeDate', function (e) {
            var inp = $('input', this), sel = false;
            for (var i = 0; i < inp.length; i++) {
                if (inp.eq(i).val()) {
                    sel = true;
                    break;
                }
            }
            var all = $('input', datePickrs);
            if (sel) {
                all.attr('disabled', 'disabled');
                inp.removeAttr('disabled');
            }
            else {
                all.removeAttr('disabled');
            }
        });
        $('#toggleFilters').click(function (e) {
            e.preventDefault();
            if ($(this).html().indexOf("Ẩn") > -1) {
                $('#divFilters').hide();
                $(this).html($(this).html().replace('Ẩn', 'Hiện'));
            }
            else {
                $('#divFilters').show();
                $(this).html($(this).html().replace('Hiện', 'Ẩn'));
            }
        });

