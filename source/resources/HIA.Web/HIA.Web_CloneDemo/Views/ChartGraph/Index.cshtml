@using HIA.Core.Languages.TitlePage;
@using Nancy.Json;
@model HIA.Core.Models.Diagram.TotalReports

@{
    ViewData["Title"] = $"Biểu đồ Thống kê";
}
<link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/elite/icons/font-awesome/css/fontawesome.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/home.min.css")" />
<style>
    .chart-wrapper .override-text {
        left: auto;
        right: 10px;
        bottom: 0;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.6.2/modernizr.js" integrity="sha512-SJYdL2kA5iRh/PXQY8so9DvAkBtfVPcIk5pL0aPlsYjeHE7fUNWmWSVsX3X8zldgBxffJmlhxnp1gT59ZDFYqA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>

<div class="home-wrapper">
    <div class="row panel-wrapper">
        <div class="col-12 col-md-6 col-xl-3 panel-custom blue">
            <div class="panel-content">
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong ngày:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalFilesDate.ToString("##,##0")
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong tháng:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalFilesMonth.ToString("##,##0")
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        % Bảo hiểm y tế:
                    </div>
                    <div class="col-3 p-detail-number">
                        100%
                    </div>
                </div>
            </div>
            <div class="panel-title">
                <div class="row">
                    <div class="col-10 p-title-label">
                        Tổng Số Hồ Sơ
                    </div>
                    <div class="col-2 p-title-icon">
                        <img src="@Url.Content("~/imgs/db-ico-1.png")" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 panel-custom green">
            <div class="panel-content">
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong ngày:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalNoiTruDate.ToString("##,##0")
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong tháng:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalNoiTruMonth.ToString("##,##0")
                    </div>
                </div>
            </div>
            <div class="panel-title">
                <div class="row">
                    <div class="col-10 p-title-label">
                        Điều Trị Nội Trú
                    </div>
                    <div class="col-2 p-title-icon">
                        <img src="@Url.Content("~/imgs/db-ico-2.png")" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 panel-custom greenleaf">
            <div class="panel-content">
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong ngày:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalRaVienDate.ToString("##,##0")
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-9 p-detail-label">
                        Trong tháng:
                    </div>
                    <div class="col-3 p-detail-number">
                        @Model.TotalRaVienMonth.ToString("##,##0")
                    </div>
                </div>
            </div>
            <div class="panel-title">
                <div class="row">
                    <div class="col-10 p-title-label">
                        Tình Trạng Ra Viện
                    </div>
                    <div class="col-2 p-title-icon">
                        <img src="@Url.Content("~/imgs/db-ico-3.png")" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 panel-custom red">
            <div class="panel-content">
                <div class="p-detail row">
                    <div class="col-6 p-detail-label">
                        Trong ngày:
                    </div>
                    <div class="col-6 p-detail-number">
                        @((Model.TongTienDate ?? 0d).ToString("##,##0.00"))
                    </div>
                </div>
                <div class="p-detail row">
                    <div class="col-6 p-detail-label">
                        Trong tháng:
                    </div>
                    <div class="col-6 p-detail-number">
                        @((Model.TongTienMonth ?? 0d).ToString("##,##0.00"))
                    </div>
                </div>
                <div class="p-detail row detail-unit">
                    <span class="unit">(Đơn vị tính: vnd)</span>
                </div>
            </div>
            <div class="panel-title">
                <div class="row">
                    <div class="col-10 p-title-label">
                        Tổng Tiền Thanh Toán Bảo Hiểm
                    </div>
                    <div class="col-2 p-title-icon">
                        <img src="@Url.Content("~/imgs/db-ico-4.png")" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="home-wrapper">
    <div class="row panel-wrapper">
        <div class="col col-md-6 panel-custom">
            <div class="chart-wrapper" id="chartContainer1" style="height: 360px;"></div>
        </div>
        <div class="col col-md-6 panel-custom">
            <div class="chart-wrapper" id="chartContainer2" style="height: 360px;"></div>
        </div>
    </div>
    <div class="row panel-wrapper">
        <div class="chart-wrapper" id="chartContainer3" style="height: 320px;"></div>
    </div>
</div>

@Html.Raw(@ViewBag.TotalFileTongTienMonth)

@{
    var lstTotal = new JavaScriptSerializer().Serialize(Model.ChartPoints["TongHop"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstKham = new JavaScriptSerializer().Serialize(Model.ChartPoints["KhamBenh"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstNoi = new JavaScriptSerializer().Serialize(Model.ChartPoints["NoiTru"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstNgoai = new JavaScriptSerializer().Serialize(Model.ChartPoints["NgoaiTru"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstMoney = new JavaScriptSerializer().Serialize(Model.ChartPoints["TongTien"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");

    var lstBH = new JavaScriptSerializer().Serialize(Model.ChartPoints["TienBH"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstBN = new JavaScriptSerializer().Serialize(Model.ChartPoints["TienBN"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstTB = new JavaScriptSerializer().Serialize(Model.ChartPoints["ChiTB"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstNTB = new JavaScriptSerializer().Serialize(Model.ChartPoints["NoiTB"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");
    var lstGTB = new JavaScriptSerializer().Serialize(Model.ChartPoints["NgoaiTB"]).Replace("\"new Date", "new Date").Replace(")&nbsp;\"", ")").Replace("\"label\"", "\"x\"");

    var lstBenh = new JavaScriptSerializer().Serialize(Model.PieCharts);
}

@section Scripts {
    <script type="text/javascript">
        function addTextOverrideCanvasJsTrial(id) {
            const div = document.createElement("div");
            div.className = "override-text";
            $(`#${id}`).append(div);
        }
        $(function () {
            CanvasJS.addCultureInfo("vn", {
                decimalSeparator: ",",
                digitGroupSeparator: "."
            });

            var chart1 = new CanvasJS.Chart('chartContainer1', {
                exportEnabled: true,
                animationEnabled: true,
                culture: 'vn',
                height: 360,
                title: {
                    text: 'THỐNG KÊ HỒ SƠ KCB',
                    fontFamily: 'sans-serif',
                    fontSize: 20,
                    fontWeight: 'bold',
                    padding: 10
                },
                legend: {
                    cursor: 'pointer',
                    itemclick: toggleDataSeries
                },
                toolTip: {
                    shared: true
                },
                axisX: {
                    interlacedColor: '#F0F8FF',
                    labelAutoFit: true,
                    labelWrap: true,
                    labelMaxWidth: 32,
                    labelFontSize: 10,
                    interval: 1,
                    intervalType: 'month',
                    tickColor: '#ccc',
                    tickLength: 5,
                    tickThickness: 3,
                    valueFormatString: '"Th"M YYYY',
                },
                data: [
                    {
                        type: 'column',
                        color: '#4dbbd3',
                        name: 'Khám bệnh',
                        showInLegend: true,
                        xValueFormatString: '"Tháng" M-YYYY',
                        yValueFormatString: '#,##0.## hồ sơ',
                        dataPoints: @Html.Raw(lstKham)
                    },
                    {
                        type: 'column',
                        color: '#f70000',
                        name: 'Ngoại trú',
                        showInLegend: true,
                        yValueFormatString: '#,##0.# hồ sơ',
                        dataPoints: @Html.Raw(lstNgoai)
                    },
                    {
                        type: 'column',
                        color: '#1a227e',
                        name: 'Nội trú',
                        showInLegend: true,
                        yValueFormatString: '#,##0.# hồ sơ',
                        dataPoints: @Html.Raw(lstNoi)
                    },
                    {
                        type: 'line',
                        color: '#18a475',
                        name: 'Tổng hồ sơ',
                        connectNullData: true,
                        showInLegend: true,
                        nullDataLineDashType: 'solid',
                        yValueFormatString: '#,##0.##  hồ sơ',
                        dataPoints: @Html.Raw(lstTotal)
                    },
                    {
                        type: 'line',
                        color: '#d44bfa',
                        name: 'Tổng tiền',
                        connectNullData: true,
                        showInLegend: true,
                        nullDataLineDashType: 'solid',
                        yValueFormatString: '#,##0.## triệu Đồng',
                        axisYType: 'secondary',
                        dataPoints: @Html.Raw(lstMoney)
                    },
                ]
            });



            var chart2 = new CanvasJS.Chart('chartContainer2', {
                exportEnabled: true,
                animationEnabled: true,
                culture: 'vn',
                height: 360,
                title: {
                    text: 'THỐNG KÊ CHI PHÍ KCB',
                    fontFamily: 'sans-serif',
                    fontSize: 20,
                    fontWeight: 'bold',
                    padding: 10
                },
                legend: {
                    cursor: 'pointer',
                    itemclick: toggleDataSeries
                },
                toolTip: {
                    shared: true
                },
                axisX: {
                    interlacedColor: '#F0F8FF',
                    labelAutoFit: true,
                    labelWrap: true,
                    labelMaxWidth: 32,
                    labelFontSize: 10,
                    interval: 1,
                    intervalType: 'month',
                    tickColor: '#ccc',
                    tickLength: 5,
                    tickThickness: 3,
                    valueFormatString: '"Th"M YYYY',
                },
                data: [
                    {
                        type: 'column',
                        color: '#4dbbd3',
                        name: 'Tổng chi phí',
                        showInLegend: true,
                        xValueFormatString: '"Tháng" M-YYYY',
                        yValueFormatString: '#,##0.## triệu Đồng',
                        dataPoints: @Html.Raw(lstMoney)
                    },
                    {
                        type: 'column',
                        color: '#f79647',
                        name: 'Bảo hiểm thanh toán',
                        showInLegend: true,
                        yValueFormatString: '#,##0.## triệu Đồng',
                        dataPoints: @Html.Raw(lstBH)
                    },
                    {
                        type: 'column',
                        color: '#1a227e',
                        name: 'Bệnh nhân thanh toán',
                        showInLegend: true,
                        yValueFormatString: '#,##0.## triệu Đồng',
                        dataPoints: @Html.Raw(lstBN)
                    },
                    {
                        type: 'line',
                        color: '#f70000',
                        name: 'Chi phí TB',
                        connectNullData: true,
                        showInLegend: true,
                        nullDataLineDashType: 'solid',
                        yValueFormatString: '#,##0.## triệu Đồng',
                        axisYType: 'secondary',
                        dataPoints: @Html.Raw(lstTB)
                    },
                    {
                        type: 'line',
                        color: '#18a475',
                        name: 'Chi phí ngoại trú TB',
                        connectNullData: true,
                        showInLegend: true,
                        nullDataLineDashType: 'solid',
                        yValueFormatString: '#,##0.## triệu Đồng',
                        axisYType: 'secondary',
                        dataPoints: @Html.Raw(lstGTB)
                    },
                    {
                        type: 'line',
                        color: '#d44bfa',
                        name: 'Chi phí nội trú TB',
                        connectNullData: true,
                        showInLegend: true,
                        nullDataLineDashType: 'solid',
                        yValueFormatString: '#,##0.## triệu Đồng',
                        axisYType: 'secondary',
                        dataPoints: @Html.Raw(lstNTB)
                    },
                ]
            });

            chart1.render();
            addTextOverrideCanvasJsTrial("chartContainer1");

            chart2.render();
            addTextOverrideCanvasJsTrial("chartContainer2");

            function toggleDataSeries(e) {
                if (typeof (e.dataSeries.visible) === 'undefined' || e.dataSeries.visible) {
                    e.dataSeries.visible = false;
                } else {
                    e.dataSeries.visible = true;
                }
                e.chart.render();
            }
        });

        window.onload = function () {

            var chart3 = new CanvasJS.Chart("chartContainer3", {
                exportEnabled: true,
                animationEnabled: true,
                title: {
                    text: 'TỔNG HỢP 20 BỆNH PHỔ BIẾN',
                    fontFamily: 'sans-serif',
                    fontSize: 20,
                    fontWeight: 'bold',
                    padding: 10
                },
                legend: {
                    cursor: "pointer",
                    itemclick: explodePie,
                    horizontalAlign: "right", 
                    verticalAlign: "center"
                },
                height: 320,
                data: [{
                    type: "pie",
                    showInLegend: false,
                    toolTipContent: "{name}: <strong>{y} bn</strong>",
                    indexLabel: "{name} - {y} bn",
                    dataPoints: @Html.Raw(lstBenh)
                }]
            });
            chart3.render();
            addTextOverrideCanvasJsTrial("chartContainer3");
        }

        function explodePie(e) {
            if (typeof (e.dataSeries.dataPoints[e.dataPointIndex].exploded) === "undefined" || !e.dataSeries.dataPoints[e.dataPointIndex].exploded) {
                e.dataSeries.dataPoints[e.dataPointIndex].exploded = true;
            } else {
                e.dataSeries.dataPoints[e.dataPointIndex].exploded = false;
            }
            e.chart.render();

        }
    </script>
}