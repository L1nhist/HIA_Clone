    var arr = (ViewBag.AlertList as int?[]).Select(i => (i?.ToString() ?? "")).ToArray();
    string almCodes = string.Join(",", arr);
}
@section Scripts {

    <script src="@Url.Content("~/lib/bootstrap-datepicker/bootstrap-datepicker.min.js")"></script>
    <script src="@Url.Content("~/lib/select2/select2.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/lib/elite/libs/datatables.net-bs4/js/dataTables.responsive.min.js")"></script>
    <script>
        const alertCodes = [@(almCodes)];

        let currentXml1Id = 0;
        let errorList = [];
        let errorXml1List = [];
        let errorXml2List = [];
        let errorXml3List = [];
        let errorXml4List = [];
        let errorXml5List = [];
        let xml1Data = {};
        let chgDate = 0;
        
        $('.dating-change').change(function(e){e.preventDefault();e.stopPropagation();callFilter(1);});
        $('.filter-change').change(function(e){e.preventDefault();e.stopPropagation();callFilter(0);});
        $('.select2').select2({ theme: "bootstrap" });
        
        var errAll=$('#errAll'), cntAll = $('#cntAll'), errSel = $('#errSel');
        errAll.change(function(){
            var b=$(this).prop('checked'), cntLst=$('#errLst .noti-cnt');

            $('#errLst .sel-one').prop('checked', b);
            var cnt = 0;
            if (b){
                cntLst.each(function(i,c){
                    cnt+=parseInt($(c).html());
                });
            }
            cntAll.html(cnt);
        });
        errSel.click(function(e){
            e.preventDefault();

            if (!$("#errLst .sel-one:checked").length) {
                alert('Vui lòng chọn ít nhất 1 mã lỗi để xem');
            }

            callFilter(0);
        });

        function getPostData(d){
            d.dateType = $("#dateType").val();
            d.dateRange = [$("#dateFrom").val(), $('#dateTo').val()];
            if (!errAll.prop('checked'))
            {
                d.errorList = $("#errLst .sel-one:checked").val();
            }
            d.kcbType = $('#kcbType').val();
            d.hospitalCode = $('#hospitalCode').val();
            return d;
        }
        function bindErrorList()
        {
            var cnt = 0, lst = $('#errLst'), chks = $('.sel-one:checked', lst).val();
            lst.empty();

            $.ajax({
                type: "POST",
                url:  "@Url.Action(nameof(FilesController.GetCounterErrors), Uti.GetControllerName(nameof(FilesController)))",
                data: getPostData({}),
                dataType: "json",
                success: function(data) {
                    var all = errAll.prop('checked'), cnt = 0, itm = 0;

                    $.each(data, function(i, d) {
                        var li = $('<li />').appendTo(lst);
                        var lb = $('<label />').attr('for', 'sel'+i.toString()).appendTo(li);
                        var ip = $('<input />').addClass('sel-one').attr('id', 'sel'+i.toString()).attr('type', 'checkbox').attr('value', d['errorCode']).appendTo(lb);

                        if (!chks || chks.length == 0 ? all : chks.indexOf(d['errorCode']) > -1) {
                            ip.prop('checked', true);
                            cnt += parseInt(d['errorCount']);
                        }
                        else {
                            ip.prop('checked', false);
                            all = false;
                        }

                        ip.change(function() {
                            var sel = 1, cnt = 0, errLst=$('#errLst .sel-one'), cntLst=$('#errLst .noti-cnt');
                            cntLst.each(function(i){
                                if(errLst.eq(i).prop('checked')) {
                                    cnt += parseInt($(this).html());
                                }
                                else {
                                    sel = 0;
                                }
                            });

                            errAll.prop('checked', sel == 1);
                            cntAll.html(cnt);
                        });

                        lb.append($('<span class="noti-cnt">' + d['errorCount'] + '</span>'));
                        var an = $('<a href="#' + d['errorCode'] + '" title="' + d['errorContent'] + '">' + d['errorContent'] + '</a>').appendTo(li);
                        an.click(function(e){
                            e.preventDefault();

                            var par = $(this).parent();
                            errAll.prop('checked', false);
                            $('#errLst .sel-one').prop('checked', false);
                            $('.sel-one', par).prop('checked', true);
                            cntAll.html($('.noti-cnt', par).html());
                            callFilter(0);
                        });
                    });

                    errAll.prop('checked', all);
                    cntAll.html(cnt);
                },
                error:function(){alert('Không thể tải được danh sách Thống kê lỗi!');}
            });
        }
        bindErrorList();

        var tmrFilter = 0;
        function callFilter(b) {
            if (tmrFilter) { clearTimeout(tmrFilter); tmrFilter = 0; }
            tmrFilter = setTimeout(function () {
                dataTbl.ajax.reload();
                if (b) {
                    bindErrorList();
                }
            }, 500);
        }

        var datePickrs = $('.input-daterange');
