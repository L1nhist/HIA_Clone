        function renderCell(data, xmlFileName, propertyName, sttNameField, row) {
            let errs = [];
            let alms = [];
            if (errorList?.length)
            {
                errs = errorList.filter(x =>
                    x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === xmlFileName
                    && x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.XeErrorRow))'] === row[sttNameField]
                    && x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLTag))'].toLowerCase() === propertyName.toLowerCase());

                alms = errs.filter(e => alertCodes.indexOf(parseInt(e['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.XeErrorCode))'])) >= 0);
            }

            if (!errs.length) {
                return data;
            }

            let msg = errs.map(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorContent))']).join(', ');
            return errs.length == alms.length ? `${data} <i class="fas fa-exclamation-circle alert-icon" title="${msg}"></i>` : `${data} <i class="fas fa-exclamation-triangle error-icon" title="${msg}"></i>`;
        }
