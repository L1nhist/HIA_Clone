        var downloadUrls = [
                                '@Url.Action(nameof(FilesController.GetDownloadData1), Uti.GetControllerName(nameof(FilesController)))',
                                '@Url.Action(nameof(FilesController.GetDownloadData2), Uti.GetControllerName(nameof(FilesController)))',
                                '@Url.Action(nameof(FilesController.GetDownloadData3), Uti.GetControllerName(nameof(FilesController)))',
                                '@Url.Action(nameof(FilesController.GetDownloadData4), Uti.GetControllerName(nameof(FilesController)))',
                                '@Url.Action(nameof(FilesController.GetDownloadData5), Uti.GetControllerName(nameof(FilesController)))'
                            ];
        function downloadFile(idx) {
            const xml1Length = dataTbl?.data()?.length;
            if (!xml1Length) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: 'Không có dữ liệu.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }
            //if (!$("#select2FilterError").val()?.length && !$("#fromDateOut").val() && !$("#toDateOut").val()) {
            //    $.toast({
            //        heading: 'Cảnh báo',
            //        text: 'Vui lòng chọn ngày ra viện (từ ngày nào đến ngày nào) hoặc loại lỗi để tải báo cáo.',
            //        position: 'top-center',
            //        loaderBg: '#ff6849',
            //        icon: 'error',
            //        hideAfter: 3500,
            //        stack: 6
            //    });
            //    return;
            //}

            var hasDate=false;
            var inp=$('input', datePickrs);
            for(var i=0;i<inp.length;i++){
                if(inp.eq(i).val()){
                    hasDate=true;
                    break;
                }
            }

            if (!hasDate) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: 'Vui lòng chọn ít nhất 1 mục ngày tháng (ngày vào, ngày ra, ngày tạo hoặc ngày thanh toán) hoặc loại lỗi để tải báo cáo.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            $(".btn-download").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");

            $.ajax({
                url: downloadUrls[idx],
                method: "GET",
                contentType: "application/json",
                cache: false,
                success: function (response) {
                    $("#spinnerWrapper").modal("hide");
                    $(".btn-download").removeClass('disabled-custom');

                    if (response.code != 200) {
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 3500,
                            stack: 6
                        });
                        return;
                    }

                    window.location = '@Url.Action(nameof(FilesController.Download), Uti.GetControllerName(nameof(FilesController)))' + `?fileGuid=${response.data.fileGuid}&fileName=${response.data.fileName}`;
                    setTimeout(() => {
                        $.toast({
                            heading: 'Thành công',
                            text: '',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 3500,
                            stack: 6
                        });
                    }, 2000);
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $(".btn-download").removeClass('disabled-custom');

                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                }
            });
        }

        function downloadXml1() {
            if (!xml1Data?.fileName || !xml1Data?.createDate) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: 'Dữ liệu XML1 không hợp lệ.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            window.location = '@Url.Action(nameof(FilesController.DownloadXml1), Uti.GetControllerName(nameof(FilesController)))' + `?fileName=${xml1Data.fileName}&date=${xml1Data.createDate}`;
        }
        function reloadXml1() {
            $("#spinnerWrapper").modal("show");
            //xml1Data = dataTbl.row(this).data();
            //currentXml1Id = xml1Data.xmL1ID;
            $.ajax({
                url: "@Url.Action(nameof(FilesController.RecheckXml1Error), Uti.GetControllerName(nameof(FilesController)))" + `?xml1Id=${currentXml1Id}`,
                method: 'GET',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (res) {
                    if (!res) return;
                    clearErrTotalForTab();
                    $("#tbl_xml1Error_wrapper").html(res.partialView);
                    $("#detailModal").modal("show");

                    errorList = res.data;

                    errorXml1List = errorList.filter(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === 'XML1');
                    setErrorTotalForTab(errorXml1List?.length || 0, 'xml1ErrorTotal');

                    errorXml2List = errorList.filter(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === 'XML2');
                    setErrorTotalForTab(errorXml2List?.length || 0, 'xml2ErrorTotal');

                    errorXml3List = errorList.filter(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === 'XML3');
                    setErrorTotalForTab(errorXml3List?.length || 0, 'xml3ErrorTotal');

                    errorXml4List = errorList.filter(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === 'XML4');
                    setErrorTotalForTab(errorXml4List?.length || 0, 'xml4ErrorTotal');

                    errorXml5List = errorList.filter(x => x['@Uti.SetLowerCaseFirstChar(nameof(XML1ErrorInfoModel.ErrorAtXMLFile))'] === 'XML5');
                    setErrorTotalForTab(errorXml5List?.length || 0, 'xml5ErrorTotal');

                    //$(".maBenhNhan").val(xml1Data.mA_BN);
                    //$(".tenBenhNhan").val(xml1Data.hO_TEN);
                    $(".maBenhNhan").val("Đã kiểm tra lại Hồ Sơ");
                    //$(".tenBenhNhan").val(xml1Data.hO_TEN);

                    getXml1Modal();
                    xml2Tbl.ajax.reload();
                    xml3Tbl.ajax.reload();
                    xml4Tbl.ajax.reload();
                    xml5Tbl.ajax.reload();
                    healthCareHistoryTbl.ajax.reload();
                    $("#spinnerWrapper").modal("hide");
                    setTimeout(() => {
                        $('#tbl_DataTable_Xml1Err').DataTable({
                            responsive: false,
                            bPaginate: false,
                            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
                        });
                    }, 0);
                },
                fail: function (jqXHR, textStatus) {
                    alert("Request failed: " + textStatus);
                }
            });
        }

        function recheckAll() {
            const xml1Length = dataTbl?.data()?.length;
            if (!xml1Length || xml1Length > 3000) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: xml1Length ? 'Số lượng hồ sơ quá lớn (> 3000).' : 'Không có dữ liệu.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            var hasDate = false;
            var inp = $('input', datePickrs);
            for (var i = 0; i < inp.length; i++) {
                if (inp.eq(i).val()) {
                    hasDate = true;
                    break;
                }
            }

            if (!hasDate) {
                $.toast({
                    heading: 'Cảnh báo',
                    text: 'Vui lòng chọn ít nhất 1 mục ngày tháng (ngày vào, ngày ra, ngày tạo hoặc ngày thanh toán) hoặc loại lỗi để tải báo cáo.',
                    position: 'top-center',
                    loaderBg: '#ff6849',
                    icon: 'error',
                    hideAfter: 3500,
                    stack: 6
                });
                return;
            }

            if (!confirm('Những hồ sơ đã chọn sẽ được đánh dấu để kiểm tra lại tự động. Bạn đã chắc chắn muốn thực hiện chức năng này???')) return;

            $("#btnRecheck").addClass('disabled-custom');
            $("#spinnerWrapper").modal("show");

            var path = '@Url.Action(nameof(FilesController.SetItemsRecheck), Uti.GetControllerName(nameof(FilesController)))';
            $.ajax({
                url: path,
                data: {
                    filterDateIns: [$("#fromDateIn").val(), $('#toDateIn').val()],
                    filterDateOuts: [$("#fromDateOut").val(), $('#toDateOut').val()],
                    filterDateCreates: [$("#fromDateCreate").val(), $('#toDateCreate').val()],
                    departments: $("#filterDepartment").val(),
                    filterErrors: $("#filterError").val(),
                    filterStatus: $('#filterStatus').val(),
                    filterDatePaids: [$("#fromDatePaid").val(), $('#toDatePaid').val()],
                    filterKCB: $('#filterKCB').val(),
                    filterHospital: $('#filterHospital').val(),
                },
                method: "POST",
                dataType: "json",
                success: function (res) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnRecheck").removeClass('disabled-custom');

                    if (!res.recordsTotal) {
                        $.toast({
                            heading: 'Thất bại',
                            text: 'Đã có lỗi hệ thống.',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'error',
                            hideAfter: 3500,
                            stack: 6
                        });
                    }
                    else {
                        $.toast({
                            heading: 'Thành công',
                            text: res.recordsTotal.toString() + ' hồ sơ đã vào hàng đợi, vui lòng chờ hệ thống kiểm tra lại hoàn thành',
                            position: 'top-center',
                            loaderBg: '#ff6849',
                            icon: 'success',
                            hideAfter: 5000,
                            stack: 6
                        });

                        dataTbl.ajax.reload();
                    }
                },
                error: function (e) {
                    $("#spinnerWrapper").modal("hide");
                    $("#btnDownload").removeClass('disabled-custom');

                    $.toast({
                        heading: 'Thất bại',
                        text: 'Đã có lỗi hệ thống.',
                        position: 'top-center',
                        loaderBg: '#ff6849',
                        icon: 'error',
                        hideAfter: 3500,
                        stack: 6
                    });
                }
            });
        }


