                var bgColor = "";
                if (data.checked != 99) {
                    if (data.hasError) {
                        bgColor = "OrangeRed";
                    }
                    else if (data.mhtcid) {
                        bgColor = "LimeGreen";
                    }
                    $(row).css("color", bgColor);
