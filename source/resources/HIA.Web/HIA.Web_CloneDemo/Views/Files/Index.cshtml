                            oLanguage: @Html.Raw(DataTableSettingDefault.O_LANGUAGE),
                        });
                    }, 0);
                },
                fail: function (jqXHR, textStatus) {
                    alert("Request failed: " + textStatus);
                }
            });
        });
        
        function resetAlertCodeXml1() {
            $('#tblXml1 .error-row').each(function(){
                var d=$(this).data('error-code');
                if(!d) return;

                d=d.toString().split(',');
                var cnt=0;
                for (var i = 0; i < d.length; i++)
                {
                    if (alertCodes.indexOf(parseInt(d[i])) >= 0) {
                        cnt++;
                    }
                }
                if (d.length == cnt) {
                    $(this).addClass('alert-row').removeClass('error-row');
                    $('.error-icon', this).addClass('fa-exclamation-circle alert-icon').removeClass('fa-exclamation-triangle').removeClass('error-icon');
                }
            });
        }

