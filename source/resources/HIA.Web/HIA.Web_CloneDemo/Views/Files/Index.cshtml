@* @using System.Security.Claims;
@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@using HIA.Core.Models.Files;
@using HIA.Core.Models.Token;

@{
    ViewData["Title"] = @DisplayFieldResource.MENU_HOSO_MAGEME;

    var xml1Display = new XML1InfoModel();
    var xml2Display = new XML2InfoModel();
    var xml3Display = new XML3InfoModel();
    var xml4Display = new XML4InfoModel();
    var xml5Display = new XML5InfoModel();

    var isMaster = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.MASTER);
    var isAdmin = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.ADMIN);
    var isUser = User.FindFirst(ClaimTypes.Role)?.Value?.Contains(RoleConstant.USER);
    var currentMaCSKCB = User.FindFirst(ClaimKey.MA_CSKCB).Value;
}

<link rel="stylesheet" href="@Url.Content("~/lib/bootstrap-datepicker/bootstrap-datepicker.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2-bootstrap.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/elite/css/page/tab-page.css")" />
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/dataTables.bootstrap4.css")">
<link rel="stylesheet" type="text/css"
      href="@Url.Content("~/lib/elite/libs/datatables.net-bs4/css/responsive.dataTables.min.css")">

<div class="container-fluid">
    <div class="page-titles">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
            <li class="breadcrumb-item active">Thống kê lỗi</li>
        </ol>
        <div class="dropdown error-wrapper">
            <a class="title dropdown-toggle waves-effect" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Thống kê lỗi
            </a>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                <div class="err-lst">
                    <ul id="errLst"></ul>
                </div>
                <div class="err-all bg-light">
                    <label for="errAll">
                        <input id="errAll" type="checkbox" checked />
                        Chọn tất cả
                    </label>
                    <a class="btn btn-sm btn-outline-dark btn-inline" id="errSel">Xem <span id="cntAll" class="noti-cnt" style="display: none;"></span></a>
                </div>
            </div>
        </div>
    </div>

    <div class="card filter-wrapper fix-hei">
        <div class="card-body">
            <div class="row" id="divFilters">
                <div class="col-auto">
                    <select name="dateType" id="dateType" class="form-control dating-change">
                        <option value="0" selected>Ngày tạo:</option>
                        <option value="1">Ngày TT:</option>
                        <option value="2">Ngày ra:</option>
                    </select>
                </div>
                <div class="col-auto">
                    <div class="input-daterange input-group col-9" id="datepicker">
                        <input id="dateFrom" name="dateRange" type="text" class="custom-daterange form-control left-control dating-change" placeholder="dd/mm/yyyy" value="@(DateTime.Now.AddDays(-7).ToString("dd/MM/yyyy"))" />
                        <span class="input-group-text custom-group-text">đến</span>
                        <input id="dateTo" name="dateRange" type="text" class="custom-daterange form-control right-control dating-change" placeholder="dd/mm/yyyy" value="@(DateTime.Now.ToString("dd/MM/yyyy"))" />
                    </div>
                </div>
                <div class="col-auto">
                    <select name="kcbType" id="kcbType" class="form-control filter-change">
                        <option selected>Loại KCB</option>
                        <option value="1">Khám bệnh</option>
                        <option value="2">Điều trị ngoại trú</option>
                        <option value="3">Điều trị nội trú</option>
                    </select>
                </div>
                @if (isMaster == true)
                {
                    <div class="col-auto">
                        <select name="hospitalCode" id="hospitalCode" class="form-control select2 filter-change">
                            <option value="" selected>Chọn Bệnh viện</option>
                            @foreach (var item in ViewBag.Hospitals)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="hospitalCode" id="hospitalCode" value="@currentMaCSKCB" />
                }
                <div class="col-auto right">
                    <button onclick="downloadFile(0)" id="btnDownload0" class="btn btn-inline btn-primary btn-download">Tải Báo cáo</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card files-wrapper">
        <div class="card-body">
            <div class="table-responsive fixed-table-custom file-management">
                <table class="table table-bordered table-striped table-data" id="tbl_DataTable">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(x => xml1Display.Stt)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.MA_LK)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.MA_BN)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.MA_THE)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.HO_TEN)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Ngay_SINH)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Gioi_TINH)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Dia_CHI)</th>

                            <th>@Html.DisplayNameFor(x => xml1Display.MA_BENH)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Ten_BENH)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.MA_DKBD)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Ket_QUA_DTRI)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Tinh_TRANG_RV)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.MA_LOAI_KCB)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.SO_NGAY_DTRI)</th>

                            <th>@Html.DisplayNameFor(x => xml1Display.Ngay_VAO)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Ngay_RA)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.Ngay_TTOAN)</th>
                            <th>@Html.DisplayNameFor(x => xml1Display.CreateDate)</th>
                        </tr>
                    </thead>
                </table>
            </div>

        </div>
    </div>
</div>

