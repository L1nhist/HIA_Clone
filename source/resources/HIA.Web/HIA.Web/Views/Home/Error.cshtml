@using HIA.Core.Languages.TitlePage;
@using HIA.Core.Languages.Message;
@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Favicon icon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")">
    <title>@TitlePageResource.ERROR - @TitlePageResource.WEBSITE_NAME</title>

    <!-- Custom CSS -->
    <link href="@Url.Content("~/lib/elite/css/style.min.css")" rel="stylesheet">
    <!-- page css -->
    <link href="@Url.Content("~/lib/elite/css/page/error-pages.css")" rel="stylesheet">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>

<body class="skin-blue fixed-layout">
    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <section id="wrapper" class="error-page">
        <div class="error-box">
            <div class="error-body text-center">
                <h1>500</h1>
                <h3 class="text-uppercase">@MessageResource.ERR_500_INTERNAL_SERVER</h3>
                <p class="text-muted m-t-30 m-b-30">@MessageResource.ERR_500_CONTACT_ADMIN</p>
                <a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))" class="btn btn-info btn-rounded waves-effect waves-light m-b-40">@DisplayFieldResource.BACK_TO_HOME</a>
            </div>

        </div>
    </section>
    <!-- ============================================================== -->
    <!-- End Wrapper -->
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- All Jquery -->
    <!-- ============================================================== -->
    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="@Url.Content("~/lib/elite/libs/popper/popper.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.min.js")"></script>
    <!--Wave Effects -->
    <script src="@Url.Content("~/lib/elite/js/waves.js")"></script>
</body>

</html>