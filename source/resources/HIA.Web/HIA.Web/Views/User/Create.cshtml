@using HIA.Core.Languages.DisplayField;
@using HIA.Web.Controllers;
@using HIA.Core.Base;
@model HIA.Core.Models.User.NewUserModel

@{
    ViewData["Title"] = @DisplayFieldResource.MENU_USER_MAGEME;
}

<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/lib/select2/select2-bootstrap.min.css")" />
<div class="container-fluid">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h6 class="text-themecolor">@DisplayFieldResource.MENU_USER_MAGEME</h6>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(HomeController.Index), Uti.GetControllerName(nameof(HomeController)))">@DisplayFieldResource.HOME</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action(nameof(UserController.Index), Uti.GetControllerName(nameof(UserController)))">@DisplayFieldResource.MENU_USER_MAGEME</a></li>
                    <li class="breadcrumb-item active">@DisplayFieldResource.CREATE_NEW</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <form asp-action="@nameof(UserController.Create)">
                <div class="row">
                    <div class="col-12 col-md-6 form-group row">
                        <label asp-for="HospitalId" class="control-label col-3 text-right"></label>
                        <div class="col-9">
                            <select asp-for="HospitalId"
                                    asp-items="@ViewBag.HospitalList"
                                    class="form-control select2">
                            </select>
                            <span asp-validation-for="HospitalId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 form-group row">
                        <label asp-for="RoleId" class="control-label col-3 text-right"></label>
                        <div class="col-9">
                            <select asp-for="RoleId"
                                    asp-items="@ViewBag.RoleList"
                                    class="form-control custom-form-control">
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 form-group row">
                        <label asp-for="Email" class="control-label col-3 text-right"></label>
                        <div class="col-9">
                            <input asp-for="Email" class="form-control custom-form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 form-group row">
                        <label asp-for="FullName" class="control-label col-3 text-right"></label>
                        <div class="col-9">
                            <input asp-for="FullName" class="form-control custom-form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 form-group row">
                        <label asp-for="PhoneNumber" class="control-label col-3 text-right"></label>
                        <div class="col-9">
                            <input asp-for="PhoneNumber" class="form-control custom-form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 form-group row">
                        <div class="col-3"></div>
                        <div class="col-9 pad-l-35">
                            <label class="form-check-label">
                                <input class="form-check-input" asp-for="IsActivated" checked="CHECKED" /> @Html.DisplayNameFor(model => model.IsActivated)<br />
                                <input class="form-check-input" asp-for="IsValidated" checked="CHECKED" /> Kích hoạt luôn
                            </label>
                        </div>
                    </div>
                </div>
                <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>
                <div class="form-group text-center">
                    <a asp-action="@nameof(UserController.Index)" class="btn btn-outline-primary">@DisplayFieldResource.BACK_TO_LIST</a>
                    <input type="submit" value="@DisplayFieldResource.CREATE_NEW" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="@Url.Content("~/lib/select2/select2.min.js")"></script>
    <script>
        $('.select2').select2({ theme: "bootstrap" });
    </script>
}