@using HIA.Core.Models.Files;
@using HIA.Core.Languages.DisplayField;
@model List<XML1ErrorInfoModel>

@{
    var xml1ErrDisplay = new XML1ErrorInfoModel();
}
<table class="table table-bordered table-striped" id="tbl_DataTable_Xml1Err">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.XeErrorCode)</th>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.XeErrorRow)</th>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.ErrorAtXMLFile)</th>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.ErrorAtXMLTag)</th>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.ErrorContent)</th>
            <th>@Html.DisplayNameFor(x => xml1ErrDisplay.ErrorComment)</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Count > 0)
        {
            for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <tr>
                    <td>@item.XeErrorCode</td>
                    <td>@item.XeErrorRow</td>
                    <td>@item.ErrorAtXMLFile</td>
                    <td>@item.ErrorAtXMLTag</td>
                    <td>@item.ErrorContent</td>
                    <td>@item.ErrorComment</td>
                </tr>
            }
        }
    </tbody>
</table>
